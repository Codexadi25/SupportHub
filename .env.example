# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
#MONGO_URI=mongodb+srv://mongodb://localhost:27017

# Session Secret
SESSION_SECRET=your_very_strong_session_secret_key

# Gemini Secret Key
GEMINI_API_KEY=your_google_gemini_api_key_here

# Version History & Broadcast Notifications
# DEPLOY_SECRET: shared secret between GitHub Actions and the app — must match on both sides
DEPLOY_SECRET=your_strong_random_deploy_secret_here
# APP_URL: public URL of your deployed app (used by CI to POST broadcast-update)
APP_URL=https://your-app-domain.com
# APP_LOB: Line of Business identifier (default: zomato)
APP_LOB=zomato

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <style>
        :root { --primary: #2563eb; --text: #1e293b; --text-muted: #64748b; --surface-alt: #f1f5f9; }
        body { font-family: 'Inter', system-ui, sans-serif; background: #f8fafc; margin: 0; padding: 20px; }
    </style>
</head>
<body>
<div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:70vh;text-align:center;">
    <h1 style="font-size:5rem;margin:0;color:var(--primary);">404</h1>
    <h2 style="margin:10px 0 20px 0;font-size:2rem;color:var(--text);">Oops! Page Not Found</h2>
    <p style="color:var(--text-muted);max-width:400px;margin-bottom:30px;line-height:1.6;">
        The page you are looking for at <code style="background:var(--surface-alt);padding:2px 6px;border-radius:4px;"><%= url %></code> doesn't exist or has been moved.
    </p>
    <a href="/" style="padding:12px 24px;background:var(--primary);color:#fff;border-radius:8px;text-decoration:none;font-weight:600;box-shadow:var(--shadow-sm);transition:var(--transition);">Return to Dashboard</a>
</div>
</body>
</html>

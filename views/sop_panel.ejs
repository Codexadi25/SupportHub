<!-- ═══════════════════════════════════════════════════════════════════
     CORE SOP SCRIPTS
     ═══════════════════════════════════════════════════════════════════ -->
<script>
    /* ─ COMP CALCULATOR ──────────────────────────────────────────── */
    function runCalc() {
        const delay = parseInt(document.getElementById('calcDelay').value);
        const ov    = parseFloat(document.getElementById('calcOV').value);
        let comp = 0;
        if (!delay || !ov) { document.getElementById('finalComp').innerText = "₹0"; return; }
        if (delay > 25 && delay <= 45) {
            comp = ov < 50 ? ov : Math.max(50, Math.min(100, ov * 0.35));
        } else if (delay > 45) {
            comp = Math.min(500, ov);
        }
        document.getElementById('finalComp').innerText = "₹" + Math.round(comp);
    }

    /* ─ SEARCH ───────────────────────────────────────────────────── */
    function filterSOP() {
        const q = document.getElementById('sopSearch').value.toLowerCase();
        document.querySelectorAll('.sop-card').forEach(c => {
            const tags  = (c.dataset.tags || '').toLowerCase();
            const title = c.innerText.toLowerCase();
            c.style.display = (tags.includes(q) || title.includes(q)) ? '' : 'none';
        });
    }

    /* ─ COPY SCRIPT ──────────────────────────────────────────────── */
    function copyScript() {
        const t = "Hi, Good Morning Sir, My name is XYZ from Zomato. May I know the reason for the delay and by when the order will be delivered?";
        navigator.clipboard.writeText(t).then(() => showToast("Script copied!", "success"));
    }

    /* ─ SOP DETAIL MODAL ─────────────────────────────────────────── */
    function openModal(card) {
        const title      = card.querySelector('.card-header').innerText;
        const cond       = card.querySelector('.card-cond').innerText;
        const actionTag  = card.querySelector('.action-tag');
        const detailText = card.querySelector('.card-detail-data').innerText;
        const tagClass   = actionTag.className.replace('action-tag ', '');

        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalCond').innerText  = cond;

        const tagEl      = document.getElementById('modalTag');
        tagEl.innerText  = actionTag.innerText;
        tagEl.className  = 'modal-tag action-tag ' + tagClass;

        document.getElementById('modalBody').innerHTML = detailText
            .split('\n').map(line => {
                line = line.trim();
                if (!line) return '<br>';
                if (line.startsWith('•')) return '<span style="display:block;margin:4px 0;">• ' + line.slice(1).trim() + '</span>';
                if (/^(Case|Note|⚠️|Special|Example|Prompt|Important|Minor|Major)/i.test(line))
                    return '<strong style="display:block;margin-top:10px;">' + line + '</strong>';
                return '<span style="display:block;">' + line + '</span>';
            }).join('');

        document.getElementById('modalOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('modalOverlay').classList.remove('open');
        document.body.style.overflow = '';
    }

    function closeModalOutside(e) {
        if (e.target === document.getElementById('modalOverlay')) closeModal();
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeModal();
            closeViewersPanel();
        }
    });

    /* ─ TOAST ────────────────────────────────────────────────────── */
    function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast' + (type ? ' ' + type : '');
        void t.offsetWidth;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    /* ═══ G-SHEET SOURCE LINK ════════════════════════════════════════
       Stores the linked sheet URL in localStorage so it persists.
       Validates it's a real Google Sheets URL before saving.
    ═══════════════════════════════════════════════════════════════ */
    const SHEET_KEY = 'wimo_source_sheet_url';

    // Boot: restore saved URL on page load
    (function initSheetButton() {
        const saved = localStorage.getItem(SHEET_KEY);
        if (saved) applySheetUrl(saved, false);
    })();

    function openSheetModal() {
        const saved = localStorage.getItem(SHEET_KEY) || '';
        const input = document.getElementById('smUrlInput');
        input.value = saved;
        onSheetUrlInput(saved);
        document.getElementById('sheetModalBackdrop').classList.add('open');
        setTimeout(() => input.focus(), 120);
    }

    function closeSheetModal() {
        document.getElementById('sheetModalBackdrop').classList.remove('open');
    }

    function closeSheetModalOutside(e) {
        if (e.target === document.getElementById('sheetModalBackdrop')) closeSheetModal();
    }

    function onSheetUrlInput(val) {
        val = val.trim();
        const valid    = isValidSheetUrl(val);
        const hasVal   = val.length > 0;
        const saveBtn  = document.getElementById('smSaveBtn');
        const preview  = document.getElementById('smPreview');
        const prevText = document.getElementById('smPreviewText');
        const clearBtn = document.getElementById('smClear');
        const openBtn  = document.getElementById('smOpenBtn');

        saveBtn.disabled = !valid;

        if (valid) {
            const name = extractSheetName(val);
            prevText.textContent = name ? '"' + name + '" — valid Google Sheets URL ✓' : 'Valid Google Sheets URL ✓';
            preview.classList.add('show');
            openBtn.href = val;
            openBtn.style.display = 'flex';
        } else {
            preview.classList.remove('show');
            openBtn.style.display = 'none';
        }

        clearBtn.classList.toggle('show', hasVal && !!localStorage.getItem(SHEET_KEY));
    }

    function saveSheetUrl() {
        const val = document.getElementById('smUrlInput').value.trim();
        if (!isValidSheetUrl(val)) return;
        localStorage.setItem(SHEET_KEY, val);
        applySheetUrl(val, true);
        closeSheetModal();
        showToast('Source sheet linked! 🔗', 'success');
    }

    function clearSheetUrl() {
        if (!confirm('Remove the linked source sheet?')) return;
        localStorage.removeItem(SHEET_KEY);
        document.getElementById('smUrlInput').value = '';
        onSheetUrlInput('');
        applySheetUrl(null, false);
        closeSheetModal();
        showToast('Source sheet removed');
    }

    function applySheetUrl(url, animate) {
        const btn  = document.getElementById('pbSheetBtn');
        const dot  = document.getElementById('pbSheetDot');
        const label = document.getElementById('pbSheetLabel');

        if (url) {
            // Make button open the sheet directly on click when linked
            btn.onclick = null;
            btn.setAttribute('data-linked', 'true');
            // Left-click opens sheet, right-click or long-press opens edit modal
            btn.addEventListener('click', handleSheetBtnClick, { once: false });
            dot.classList.add('show');
            label.textContent = 'Source Sheet';
            btn.title = 'Open source Google Sheet (right-click to change URL)';
            if (animate) {
                btn.style.transform = 'scale(1.08)';
                setTimeout(() => btn.style.transform = '', 300);
            }
        } else {
            btn.onclick = openSheetModal;
            btn.removeEventListener('click', handleSheetBtnClick);
            btn.setAttribute('data-linked', 'false');
            dot.classList.remove('show');
            label.textContent = 'Source Sheet';
            btn.title = 'Link source Google Sheet';
        }
    }

    // When linked: single click = open sheet, hold Ctrl/Meta = edit URL
    function handleSheetBtnClick(e) {
        const url = localStorage.getItem(SHEET_KEY);
        if (!url) { openSheetModal(); return; }
        if (e.ctrlKey || e.metaKey || e.shiftKey) {
            e.preventDefault();
            openSheetModal();
        } else {
            window.open(url, '_blank');
        }
    }

    // Context menu on sheet btn to quickly open edit modal
    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('pbSheetBtn');
        btn.addEventListener('contextmenu', function(e) {
            if (localStorage.getItem(SHEET_KEY)) {
                e.preventDefault();
                openSheetModal();
            }
        });
    });

    function isValidSheetUrl(url) {
        if (!url) return false;
        try {
            const u = new URL(url);
            return u.hostname === 'docs.google.com' && u.pathname.includes('/spreadsheets/');
        } catch(_) {
            return false;
        }
    }

    function extractSheetName(url) {
        // Try to extract a readable name from URL params
        try {
            const u = new URL(url);
            const title = u.searchParams.get('title') || u.searchParams.get('rm');
            if (title) return decodeURIComponent(title);
        } catch(_) {}
        return null;
    }
</script>

<!-- ═══════════════════════════════════════════════════════════════════
     LIVE PRESENCE SYSTEM  (Firebase Realtime Database)
     ═══════════════════════════════════════════════════════════════════

  HOW TO ENABLE CROSS-DEVICE SYNC (takes ~5 minutes, 100% free):
  ──────────────────────────────────────────────────────────────────
  1. Go to https://console.firebase.google.com
  2. Click "Add project" → name it → disable Analytics → Create
  3. In the left panel → Build → Realtime Database → Create Database
     → Start in test mode → Enable
  4. In left panel → Project Settings (gear icon) → Your Apps
     → Add App → Web (</>) → Register app → Copy the firebaseConfig
  5. Paste your values into the FIREBASE_CONFIG object below
  6. Save the file. All devices now sync in real time.
  ═══════════════════════════════════════════════════════════════════ -->

<script type="module">
// ─── ⚙️  PASTE YOUR FIREBASE CONFIG HERE ────────────────────────────

// const firebaseConfigSample = {
//     apiKey:            "YOUR_API_KEY",
//     authDomain:        "YOUR_PROJECT_ID.firebaseapp.com",
//     databaseURL:       "https://YOUR_PROJECT_ID-default-rtdb.firebaseio.com",
//     projectId:         "YOUR_PROJECT_ID",
//     storageBucket:     "YOUR_PROJECT_ID.appspot.com",
//     messagingSenderId: "YOUR_MESSAGING_SENDER_ID",
//     appId:             "YOUR_APP_ID"
// };

const FIREBASE_CONFIG = {
  apiKey: "AIzaSyC2XtfZ8Z5YPgT3kM-j1Bkbo83i_37OVn0",
  authDomain: "supporthubgit-25655784-dacc0.firebaseapp.com",
  databaseURL: "https://supporthubgit-25655784-dacc0-default-rtdb.asia-southeast1.firebasedatabase.app",
  projectId: "supporthubgit-25655784-dacc0",
  storageBucket: "supporthubgit-25655784-dacc0.firebasestorage.app",
  messagingSenderId: "787754082784",
  appId: "1:787754082784:web:751f958cf9e3e4e625cb85"
};
// ─────────────────────────────────────────────────────────────────────

const PRESENCE_PATH  = "wimo_sop_presence";
const HEARTBEAT_MS   = 18000;   // ping every 18 s
const STALE_THRESHOLD = 40000;  // remove viewer after 40 s silence

// Avatar palette (10 distinct, WCAG-AA on white text)
const PALETTE = [
    "#CB202D","#1565C0","#2E7D32","#6A1B9A",
    "#C62828","#00695C","#E65100","#283593",
    "#4E342E","#37474F"
];

// Role → accent colour for the panel badge
const ROLE_COLOR = {
    "Agent":       "#37474F",
    "QA Analyst":  "#1565C0",
    "Team Leader": "#2E7D32",
    "Vendor":      "#6A1B9A",
    "Admin":       "#CB202D"
};

// ─── STATE ───────────────────────────────────────────────────────────
let myProfile    = null;    // { id, name, role, color, initials, joinedAt }
let firebaseMode = false;   // true when config is valid & SDK loaded
let fbRefs       = null;    // { db, myRef, allRef, … firebase fns }
let localMap     = {};      // demo-mode only: { id → viewer }
let panelOpen    = false;

// ─── BOOT ────────────────────────────────────────────────────────────
(async function boot() {
    const configured = FIREBASE_CONFIG.apiKey !== "YOUR_API_KEY";

    if (configured) {
        try {
            const { initializeApp }   = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js");
            const { getDatabase, ref, set, onValue, remove, onDisconnect, serverTimestamp }
                = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js");

            const app = initializeApp(FIREBASE_CONFIG);
            const db  = getDatabase(app);
            fbRefs = { db, ref, set, onValue, remove, onDisconnect };
            firebaseMode = true;
            setLiveStatus("online");
        } catch(err) {
            console.warn("[WIMO presence] Firebase init failed:", err.message);
            setLiveStatus("offline");
        }
    } else {
        setLiveStatus("pending");
        document.getElementById("vpFirebaseSetup").classList.add("show");
    }

    // Check for saved profile
    const saved = localStorage.getItem("wimo_viewer_v2");
    if (saved) {
        try {
            myProfile = JSON.parse(saved);
            myProfile.joinedAt = Date.now(); // fresh join time
            closeNameModal();
            startPresence();
        } catch(_) {
            openNameModal();
        }
    } else {
        openNameModal();
    }
})();

// ─── NAME MODAL ──────────────────────────────────────────────────────
let nmSelectedRole = "Agent";

window.nmSelectRole = function(btn, role) {
    document.querySelectorAll(".nm-role-pill").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    nmSelectedRole = role;
};

window.nmOnInput = function() {
    const val = document.getElementById("nmNameInput").value.trim();
    document.getElementById("nmSubmitBtn").disabled = val.length < 2;

    // Live avatar preview
    const av = document.getElementById("nmAvatar");
    if (val.length >= 1) {
        av.textContent = getInitials(val);
        av.style.background = nameToColor(val);
        av.style.borderColor = nameToColor(val) + "33";
        av.classList.add("has-name");
    } else {
        av.textContent = "?";
        av.style.background = "#e0e0e0";
        av.style.borderColor = "#f0f0f0";
        av.classList.remove("has-name");
    }
};

window.nmSubmit = function() {
    const name = document.getElementById("nmNameInput").value.trim();
    if (name.length < 2) return;

    const color = nameToColor(name);
    myProfile = {
        id:       genId(),
        name,
        role:     nmSelectedRole,
        color,
        initials: getInitials(name),
        joinedAt: Date.now()
    };

    localStorage.setItem("wimo_viewer_v2", JSON.stringify(myProfile));
    closeNameModal();
    startPresence();
    showToast("Welcome, " + name + "! 👋", "success");
};

function openNameModal()  { document.getElementById("nameModalBackdrop").classList.add("open"); }
function closeNameModal() { document.getElementById("nameModalBackdrop").classList.remove("open"); }

// ─── PRESENCE ENGINE ─────────────────────────────────────────────────
function startPresence() {
    updateYouChip(myProfile);

    if (firebaseMode && fbRefs) {
        startFirebase();
    } else {
        startDemoMode();
    }
}

/* FIREBASE path */
function startFirebase() {
    const { db, ref, set, onValue, remove, onDisconnect } = fbRefs;
    const myRef  = ref(db, `${PRESENCE_PATH}/${myProfile.id}`);
    const allRef = ref(db, PRESENCE_PATH);

    const payload = () => ({
        name:      myProfile.name,
        role:      myProfile.role,
        color:     myProfile.color,
        initials:  myProfile.initials,
        joinedAt:  myProfile.joinedAt,
        lastSeen:  Date.now()
    });

    // Write on connect
    set(myRef, payload());

    // Auto-delete on disconnect
    onDisconnect(myRef).remove();

    // Heartbeat
    const hb = setInterval(() => set(myRef, payload()), HEARTBEAT_MS);

    // Listen to all viewers (live)
    onValue(allRef, snap => {
        const raw = snap.val() || {};
        const now = Date.now();
        const viewers = Object.entries(raw)
            .filter(([, v]) => v && (now - (v.lastSeen || 0)) < STALE_THRESHOLD)
            .map(([id, v]) => ({ id, ...v }));
        renderAll(viewers);
    });

    // Clean up on tab close
    window.addEventListener("beforeunload", () => {
        remove(myRef);
        clearInterval(hb);
    });
}

/* Demo / localStorage mode */
function startDemoMode() {
    localMap = {};
    localMap[myProfile.id] = { ...myProfile, lastSeen: Date.now() };
    renderAll(Object.values(localMap));

    // Still heartbeat so the UI feels alive
    setInterval(() => {
        localMap[myProfile.id].lastSeen = Date.now();
        renderAll(Object.values(localMap));
    }, HEARTBEAT_MS);
}

// ─── RENDER ──────────────────────────────────────────────────────────
function renderAll(viewers) {
    // Sort: me first, then by joinedAt ascending
    viewers.sort((a, b) => {
        if (a.id === myProfile.id) return -1;
        if (b.id === myProfile.id) return  1;
        return (a.joinedAt || 0) - (b.joinedAt || 0);
    });

    renderAvatarStrip(viewers);
    renderCountLabel(viewers.length);
    renderViewersPanel(viewers);
}

function renderAvatarStrip(viewers) {
    const container = document.getElementById("pbAvatars");
    const MAX = 7;
    const shown    = viewers.slice(0, MAX);
    const overflow = viewers.length - MAX;

    container.innerHTML = shown.map((v, i) => {
        const isMe = v.id === myProfile.id;
        return `<div class="pb-avatar ${isMe ? "is-you" : ""}"
                     style="background:${v.color||"#999"}; z-index:${50-i}"
                     tabindex="0">
                    ${v.initials || "?"}
                    <div class="pb-avatar-tip">
                        ${esc(v.name)}${isMe ? " <span style=\"color:#ff9090\">(You)</span>" : ""}<br>
                        <span style="opacity:.75;font-size:.6rem">${v.role || "Viewer"}</span>
                    </div>
                </div>`;
    }).join("");

    if (overflow > 0) {
        container.innerHTML += `<div class="pb-overflow" title="${overflow} more people viewing" onclick="toggleViewersPanel()">+${overflow}</div>`;
    }
}

function renderCountLabel(count) {
    const el = document.getElementById("pbCountLabel");
    if (count === 0) {
        el.innerHTML = "";
    } else if (count === 1) {
        el.innerHTML = `<span style="color:#24963F;font-weight:800;">Only you</span>`;
    } else {
        el.innerHTML = `<span style="font-weight:800;color:#2D2D2D">${count} viewing now</span>`;
    }
    document.getElementById("vpCountChip").textContent = count;
}

function renderViewersPanel(viewers) {
    const list = document.getElementById("vpList");
    list.innerHTML = viewers.map(v => {
        const isMe  = v.id === myProfile.id;
        const rc    = ROLE_COLOR[v.role] || "#555";
        const since = timeSince(v.joinedAt);
        return `<div class="vp-item">
            <div class="vp-avatar" style="background:${v.color||"#999"}">${v.initials||"?"}</div>
            <div class="vp-info">
                <div class="vp-name">${esc(v.name)}</div>
                <div class="vp-role" style="color:${rc}">${v.role||"Viewer"}</div>
            </div>
            <div class="vp-active-dot" title="Active"></div>
            ${isMe
                ? `<span class="vp-badge-you">You</span>`
                : `<span class="vp-joined-time">${since}</span>`}
        </div>`;
    }).join("") || `<div style="padding:16px;text-align:center;font-size:.8rem;color:#bbb;">No viewers yet</div>`;
}

// ─── YOUR CHIP ────────────────────────────────────────────────────────
function updateYouChip(p) {
    const chip  = document.getElementById("pbYouChip");
    const av    = document.getElementById("pbYouAvatar");
    const name  = document.getElementById("pbYouName");
    const role  = document.getElementById("pbYouRole");

    av.textContent    = p.initials || "?";
    av.style.background = p.color || "#999";
    name.textContent  = p.name;
    role.textContent  = p.role || "Viewer";
    chip.classList.add("visible");
}

// ─── LIVE STATUS DOT ─────────────────────────────────────────────────
function setLiveStatus(state) {
    const dot  = document.getElementById("pbLiveDot");
    const text = document.getElementById("pbLiveText");
    const map  = {
        online:  { dotCls: "online",  color: "#24963F", label: "Live"         },
        pending: { dotCls: "pending", color: "#F5A623", label: "Demo mode"    },
        offline: { dotCls: "offline", color: "#ccc",    label: "Disconnected" }
    };
    const s = map[state] || map.pending;
    dot.className  = "pb-live-dot " + s.dotCls;
    text.textContent = s.label;
    text.style.color = s.color;
    text.className = "pb-live-text " + s.dotCls;
}

// ─── PANEL TOGGLE ─────────────────────────────────────────────────────
window.toggleViewersPanel = function() {
    panelOpen = !panelOpen;
    document.getElementById("viewersPanel").classList.toggle("open", panelOpen);
};

function closeViewersPanel() {
    panelOpen = false;
    document.getElementById("viewersPanel").classList.remove("open");
}

document.addEventListener("click", e => {
    if (!e.target.closest("#viewersPanel") &&
        !e.target.closest("[onclick='toggleViewersPanel()']") &&
        !e.target.closest(".pb-see-all") &&
        !e.target.closest(".pb-you-chip") &&
        !e.target.closest(".pb-overflow")) {
        closeViewersPanel();
    }
});

// ─── UTILITIES ────────────────────────────────────────────────────────
function getInitials(name) {
    if (!name?.trim()) return "?";
    const p = name.trim().split(/\s+/);
    return p.length === 1
        ? p[0].substring(0, 2).toUpperCase()
        : (p[0][0] + p[p.length - 1][0]).toUpperCase();
}

function nameToColor(name) {
    if (!name) return PALETTE[0];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return PALETTE[Math.abs(h) % PALETTE.length];
}

function genId() {
    return "u_" + Math.random().toString(36).slice(2, 9) + "_" + Date.now().toString(36);
}

function timeSince(ts) {
    if (!ts) return "";
    const s = Math.floor((Date.now() - ts) / 1000);
    if (s < 10)   return "just now";
    if (s < 60)   return s + "s ago";
    if (s < 3600) return Math.floor(s / 60) + "m ago";
    return Math.floor(s / 3600) + "h ago";
}

function esc(str) {
    return String(str || "")
        .replace(/&/g,"&amp;").replace(/</g,"&lt;")
        .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}
</script>


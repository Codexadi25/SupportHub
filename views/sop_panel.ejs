// Monaco Code View Toggle
let monacoEditorInstance = null;
function openMonacoCodeView() {
    const container = document.getElementById('monaco-code-container');
    const dynamicContainer = document.getElementById('sopDynamicContainer');
    const sidebar = document.getElementById('sopSidebarContainer');
    if (!container || !dynamicContainer || !sidebar) return;

    dynamicContainer.style.display = 'none';
    sidebar.style.display = 'none';
    container.style.display = 'block';
    document.getElementById('sop-options-dropdown').style.display = 'none';

    let backBtn = document.getElementById('sop-monaco-back-btn');
    if (!backBtn) {
        backBtn = document.createElement('button');
        backBtn.id = 'sop-monaco-back-btn';
        backBtn.className = 'sop-toolbar-btn btn-purple';
        backBtn.innerHTML = '← Return to GUI Editor';
        backBtn.onclick = closeMonacoCodeView;
        document.querySelector('#sop-edit-toolbar div').insertBefore(backBtn, document.getElementById('sop-save-layout-btn'));
    }
    backBtn.style.display = 'inline-flex';

    if (!monacoEditorInstance) {
        require.config({ paths: { vs: 'https://cdnjs.cloudflare.com/ajax/libs/monaco-editor/0.39.0/min/vs' } });
        require(['vs/editor/editor.main'], function () {
            monacoEditorInstance = monaco.editor.create(container, {
                value: JSON.stringify(window.SopDraftState, null, 4),
                language: 'json',
                theme: 'vs-dark',
                automaticLayout: true,
                minimap: { enabled: false }
            });
        });
    } else {
        monacoEditorInstance.setValue(JSON.stringify(window.SopDraftState, null, 4));
    }
}

function closeMonacoCodeView() {
    const container = document.getElementById('monaco-code-container');
    const dynamicContainer = document.getElementById('sopDynamicContainer');
    const sidebar = document.getElementById('sopSidebarContainer');
    const backBtn = document.getElementById('sop-monaco-back-btn');
    if (!container || !dynamicContainer || !sidebar || !monacoEditorInstance) return;

    try {
        const nextState = JSON.parse(monacoEditorInstance.getValue());
        if (!nextState.template || !Array.isArray(nextState.cards)) {
            throw new Error("Missing 'template' object or 'cards' array");
        }
        pushState();
        window.SopDraftState = nextState;
        renderSopLayout();
        renderSidebar();

        container.style.display = 'none';
        dynamicContainer.style.display = '';
        sidebar.style.display = '';
        if (backBtn) backBtn.style.display = 'none';

        showToast('JSON code modifications applied!', 'success');
        triggerAutoSave();
    } catch (err) {
        alert('Invalid JSON structure: ' + err.message);
    }
}

// History & Diff
async function openVersionHistoryModal() {
    document.getElementById('sop-options-dropdown').style.display = 'none';
    const backdrop = buildBackdrop('sopHistoryBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:560px;max-width:97%;max-height:85vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative; font-family:inherit;">
            <button onclick="document.getElementById('sopHistoryBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1.15rem;color:#1e293b;border-bottom:2px solid #e2e8f0;padding-bottom:10px;">📜 SOP Version History</h3>
            <div id="sop-history-list" style="display:flex; flex-direction:column; gap:12px;">
                <div style="padding:20px; text-align:center; color:#64748b;"><i class="fa fa-spinner fa-spin"></i> Loading versions...</div>
            </div>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    try {
        const res = await fetch(`/${SOP_LOB}/sop/history`);
        const data = await res.json();
        if (data.success && data.history) {
            const list = document.getElementById('sop-history-list');
            if (data.history.length === 0) {
                list.innerHTML = `<div style="padding:20px; text-align:center; color:#64748b;">No version history found.</div>`;
                return;
            }
            list.innerHTML = '';
            data.history.forEach(h => {
                const item = document.createElement('div');
                item.style.cssText = 'border:1px solid #e2e8f0; border-radius:8px; padding:12px 16px; background:#f8fafc; display:flex; justify-content:space-between; align-items:center; gap: 15px;';
                item.innerHTML = `
                    <div style="flex:1;">
                        <strong style="color:#1e293b;">Version v${h.version}</strong>
                        <div style="font-size:11px; color:#64748b; margin-top:2px;">
                            Published by ${esc(h.publishedBy)} (${esc(h.publishedByRole)}) on ${new Date(h.publishedAt).toLocaleString()}
                        </div>
                    </div>
                    <div style="display:flex; gap:6px;">
                        <button class="sop-toolbar-btn btn-slate" style="padding:5px 10px; font-size:11px;" onclick="compareHistoryVersion(${h.version})">🔍 Compare</button>
                        <button class="sop-toolbar-btn btn-green" style="padding:5px 10px; font-size:11px;" onclick="rollbackToVersion(${h.version})">↩️ Rollback</button>
                    </div>
                `;
                list.appendChild(item);
            });
        } else {
            throw new Error(data.error || 'Failed to fetch history');
        }
    } catch (err) {
        document.getElementById('sop-history-list').innerHTML = `<div style="padding:20px; text-align:center; color:#ef4444;">Error: ${esc(err.message)}</div>`;
    }
}

async function compareHistoryVersion(version) {
    showToast(`Loading version v${version}...`, 'info');
    try {
        const res = await fetch(`/${SOP_LOB}/sop/history/${version}`);
        const data = await res.json();
        if (data.success && data.snapshot) {
            window.diffSnapshotData = {
                template: data.snapshot.templateSnapshot,
                cards: data.snapshot.cardsSnapshot
            };
            renderSopLayout();
            document.getElementById('sopHistoryBackdrop')?.remove();

            let clearBtn = document.getElementById('sop-clear-diff-btn');
            if (!clearBtn) {
                clearBtn = document.createElement('button');
                clearBtn.id = 'sop-clear-diff-btn';
                clearBtn.className = 'sop-toolbar-btn btn-red';
                clearBtn.style.cssText = 'position:fixed; bottom:25px; left:25px; z-index:9999; box-shadow:0 4px 15px rgba(0,0,0,0.2);';
                clearBtn.innerHTML = '✕ Clear Comparison';
                clearBtn.onclick = () => {
                    window.diffSnapshotData = null;
                    renderSopLayout();
                    clearBtn.remove();
                };
                document.body.appendChild(clearBtn);
            }
            showToast(`Comparing with Version v${version} (Borders: Green=Added, Red=Removed, Blue=Minor Edit, Orange=Major Edit)`, 'success');
        }
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}

async function rollbackToVersion(version) {
    if (!confirm(`Rollback SOP WIMO to Version v${version}? This overrides the live version.`)) return;
    try {
        const res = await fetch(`/${SOP_LOB}/sop/rollback/${version}`, { method: 'POST', credentials: 'same-origin' });
        const data = await res.json();
        if (data.success) {
            showToast(`SOP rolled back successfully to version v${version}!`, 'success');
            document.getElementById('sopHistoryBackdrop')?.remove();
            setTimeout(() => location.reload(), 1000);
        } else {
            throw new Error(data.error || 'Rollback failed');
        }
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}

function getCardDiffStatus(card) {
    if (!window.diffSnapshotData) return null;
    const snapCards = window.diffSnapshotData.cards || [];
    const match = snapCards.find(c => c.title.toLowerCase().trim() === card.title.toLowerCase().trim());
    if (!match) {
        return { className: 'diff-added', bg: '#dcfce7', color: '#15803d', label: 'Added' };
    }

    const t1 = `${card.condition}\n${card.action}\n${card.details}`;
    const t2 = `${match.condition}\n${match.action}\n${match.details}`;
    const pct = getTextDiffPercentage(t1, t2);

    if (pct === 0) return null;
    if (pct < 20) {
        return { className: 'diff-minor', bg: '#eff6ff', color: '#1d4ed8', label: 'Minor Edit' };
    } else {
        return { className: 'diff-major', bg: '#fff7ed', color: '#c2410c', label: 'Major Edit' };
    }
}

function getTextDiffPercentage(s1, s2) {
    s1 = s1 || ''; s2 = s2 || '';
    const len = Math.max(s1.length, s2.length);
    if (len === 0) return 0;
    return (levenshteinDistance(s1, s2) / len) * 100;
}

function levenshteinDistance(a, b) {
    const matrix = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
    for (let i = 1; i <= b.length; i++) {
        for (let j = 1; j <= a.length; j++) {
            if (b.charAt(i - 1) === a.charAt(j - 1)) {
                matrix[i][j] = matrix[i - 1][j - 1];
            } else {
                matrix[i][j] = Math.min(
                    matrix[i - 1][j - 1] + 1,
                    matrix[i][j - 1] + 1,
                    matrix[i - 1][j] + 1
                );
            }
        }
    }
    return matrix[b.length][a.length];
}

// Google Sheets Sync & Reconciliation
async function fetchAndReconcileSheet() {
    showToast('Fetching Google Sheet source...', 'info');
    try {
        const res = await fetch(`/${SOP_LOB}/sop/fetch-source`);
        const data = await res.json();
        if (data.success && data.data) {
            const rows = data.data;
            const reconciliation = [];
            const cards = window.SopDraftState.cards || [];

            rows.forEach(row => {
                const title = row.title || row.scenario || '';
                if (!title) return;
                const match = cards.find(c => c.title.toLowerCase().trim() === title.toLowerCase().trim());
                if (match) {
                    const condMatch = (row.condition || row.trigger || '').toLowerCase().trim() === (match.condition || '').toLowerCase().trim();
                    const actMatch = (row.action || '').toLowerCase().trim() === (match.action || '').toLowerCase().trim();
                    const detailsMatch = (row.details || row.sop || '').toLowerCase().trim() === (match.details || '').toLowerCase().trim();

                    if (condMatch && actMatch && detailsMatch) {
                        reconciliation.push({ title, mismatch: false });
                    } else {
                        reconciliation.push({ title, mismatch: true });
                    }
                }
            });

            window.sheetReconciliationData = reconciliation;
            renderSopLayout();
            closeSheetModal();

            let clearBtn = document.getElementById('sop-clear-reconcile-btn');
            if (!clearBtn) {
                clearBtn = document.createElement('button');
                clearBtn.id = 'sop-clear-reconcile-btn';
                clearBtn.className = 'sop-toolbar-btn btn-red';
                clearBtn.style.cssText = 'position:fixed; bottom:25px; left:220px; z-index:9999; box-shadow:0 4px 15px rgba(0,0,0,0.2);';
                clearBtn.innerHTML = '✕ Clear Sync Overlay';
                clearBtn.onclick = () => {
                    window.sheetReconciliationData = null;
                    renderSopLayout();
                    clearBtn.remove();
                };
                document.body.appendChild(clearBtn);
            }
            showToast('Sync Reconciliation check finished!', 'success');
        } else {
            throw new Error(data.error || 'Failed to fetch');
        }
    } catch (err) {
        showToast('Sync Error: ' + err.message, 'warning');
    }
}

// Save Sheet link URL via API
async function saveSheetUrl() {
    const url = document.getElementById('smUrlInput').value.trim();
    if (!isValidSheetUrl(url)) return;
    try {
        const res = await fetch(`/${SOP_LOB}/sop/link-source`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url }),
            credentials: 'same-origin'
        });
        const data = await res.json();
        if (data.success) {
            localStorage.setItem(SHEET_KEY, url);
            applySheetUrl(url, true);
            closeSheetModal();
            showToast('Source sheet linked successfully ✓', 'success');
        } else {
            throw new Error(data.error || 'Save failed');
        }
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}

// AI Drawer Toggle & Chat
function toggleAiSidebar() {
    const sb = document.getElementById('aiSidebar');
    if (sb) sb.classList.toggle('open');
}

async function sendAiChatMessage() {
    const input = document.getElementById('aiInput');
    const messages = document.getElementById('aiChatMessages');
    const sendBtn = document.getElementById('aiSendBtn');
    if (!input || !messages || !sendBtn) return;

    const text = input.value.trim();
    if (!text) return;

    const uMsg = document.createElement('div');
    uMsg.className = 'ai-msg user';
    uMsg.innerText = text;
    messages.appendChild(uMsg);
    input.value = '';
    messages.scrollTop = messages.scrollHeight;

    const bLoading = document.createElement('div');
    bLoading.className = 'ai-msg bot';
    bLoading.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Thinking...';
    messages.appendChild(bLoading);
    messages.scrollTop = messages.scrollHeight;

    sendBtn.disabled = true;
    try {
        const res = await fetch(`/${SOP_LOB}/sop/chat`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, context: { draftState: window.SopDraftState } })
        });
        const data = await res.json();
        if (data.success && data.reply) {
            bLoading.innerText = data.reply;
        } else {
            throw new Error(data.error || 'Failed');
        }
    } catch (err) {
        bLoading.innerText = 'AI Error: ' + err.message;
    } finally {
        sendBtn.disabled = false;
        messages.scrollTop = messages.scrollHeight;
    }
}

// ─── MISSING HELPER FUNCTIONS ────────────────────────────────────────

/**
 * Build a full-screen backdrop div for modals.
 * Removes any existing backdrop with the same id first.
 */
function buildBackdrop(id) {
    const existing = document.getElementById(id);
    if (existing) existing.remove();
    const backdrop = document.createElement('div');
    backdrop.id = id;
    backdrop.style.cssText = [
        'position:fixed', 'inset:0', 'background:rgba(0,0,0,0.55)',
        'z-index:8000', 'display:flex', 'align-items:center',
        'justify-content:center', 'backdrop-filter:blur(3px)',
        'animation:fadeIn .15s ease'
    ].join(';');
    return backdrop;
}

/**
 * Copy the text of a quick-prompt item to clipboard.
 */
function copyPromptText(el) {
    const textEl = el.querySelector('.prompt-text');
    const text = textEl ? textEl.innerText : el.innerText;
    navigator.clipboard.writeText(text)
        .then(() => showToast('Prompt copied!', 'success'))
        .catch(() => showToast('Copy failed', 'warning'));
}

/**
 * Open a publish validation/confirmation modal that shows a diff summary
 * before finally calling the publish API.
 */
async function openPublishValidationModal() {
    const backdrop = buildBackdrop('sopPublishBackdrop');

    // Build placeholder modal first so user sees it immediately
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:560px;max-width:97%;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.28);position:relative;font-family:inherit;">
            <button onclick="document.getElementById('sopPublishBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;color:#64748b;">✕</button>
            <h3 style="margin:0 0 8px;font-size:1.1rem;color:#1e293b;display:flex;align-items:center;gap:8px;">
                🚀 Publish SOP Draft
            </h3>
            <p style="font-size:0.82rem;color:#64748b;margin:0 0 18px;line-height:1.5;">
                Publishing will replace the <strong>live SOP</strong> with your current draft.
                This action will be logged in version history and <strong>cannot be undone</strong> (but can be rolled back).
            </p>
            <div id="pub-diff-area" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;font-size:0.82rem;max-height:280px;overflow-y:auto;margin-bottom:18px;">
                <i class="fa fa-spinner fa-spin"></i> Loading change summary…
            </div>
            <div style="display:flex;gap:10px;margin-top:4px;">
                <button onclick="document.getElementById('sopPublishBackdrop').remove()" style="flex:1;padding:11px;background:#f5f5f5;border:1px solid #e0e0e0;border-radius:8px;font-size:.88rem;font-weight:700;font-family:inherit;cursor:pointer;color:#64748b;">Cancel</button>
                <button id="pub-confirm-btn" disabled style="flex:2;padding:11px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-size:.88rem;font-weight:800;font-family:inherit;cursor:not-allowed;opacity:0.5;display:flex;align-items:center;justify-content:center;gap:7px;">
                    🚀 Confirm Publish
                </button>
            </div>
            <p id="pub-policy-warn" style="margin:10px 0 0;font-size:0.72rem;color:#e65100;text-align:center;display:none;">
                ⚠️ Ensure all changes comply with company policies before publishing.
            </p>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    // Fetch live data to compute diff
    try {
        const res = await fetch(`/${SOP_LOB}/sop/live`);
        const data = await res.json();
        const diffArea = document.getElementById('pub-diff-area');
        const confirmBtn = document.getElementById('pub-confirm-btn');
        const policyWarn = document.getElementById('pub-policy-warn');

        if (!data.success) throw new Error(data.error || 'Failed to load live SOP');

        const liveCards = data.cards || [];
        const draftCards = window.SopDraftState.cards || [];

        // Compute changes
        const added = [];
        const removed = [];
        const modified = [];

        draftCards.forEach(dc => {
            const match = liveCards.find(lc => lc._id && dc._id && String(lc._id) === String(dc._id));
            if (!match) {
                const titleMatch = liveCards.find(lc => lc.title?.toLowerCase() === dc.title?.toLowerCase());
                if (!titleMatch) added.push(dc.title);
                else {
                    if (titleMatch.condition !== dc.condition || titleMatch.action !== dc.action || titleMatch.details !== dc.details)
                        modified.push(dc.title);
                }
            } else {
                if (match.title !== dc.title || match.condition !== dc.condition || match.action !== dc.action || match.details !== dc.details)
                    modified.push(dc.title || match.title);
            }
        });

        liveCards.forEach(lc => {
            const stillExists = draftCards.find(dc =>
                (dc._id && lc._id && String(dc._id) === String(lc._id)) ||
                dc.title?.toLowerCase() === lc.title?.toLowerCase()
            );
            if (!stillExists) removed.push(lc.title);
        });

        const total = added.length + removed.length + modified.length;

        if (total === 0) {
            diffArea.innerHTML = `<span style="color:#16a34a;">✓ No content changes detected. Template/sidebar config may have changed.</span>`;
        } else {
            let html = `<strong style="color:#1e293b;">${total} change${total > 1 ? 's' : ''} detected:</strong><ul style="margin:8px 0 0;padding-left:18px;line-height:1.8;">`;
            added.forEach(t => { html += `<li style="color:#15803d;">➕ Added: <em>${esc(t)}</em></li>`; });
            modified.forEach(t => { html += `<li style="color:#1d4ed8;">✏️ Modified: <em>${esc(t)}</em></li>`; });
            removed.forEach(t => { html += `<li style="color:#b91c1c;text-decoration:line-through;">🗑 Removed: <em>${esc(t)}</em></li>`; });
            html += '</ul>';
            diffArea.innerHTML = html;
        }

        // Enable confirm button
        confirmBtn.disabled = false;
        confirmBtn.style.cursor = 'pointer';
        confirmBtn.style.opacity = '1';
        if (policyWarn) policyWarn.style.display = 'block';

        confirmBtn.addEventListener('click', async () => {
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Publishing…';
            try {
                // First save the latest draft state
                await saveDraftToServer();

                const pubRes = await fetch(`/${SOP_LOB}/sop/publish`, {
                    method: 'POST',
                    credentials: 'same-origin'
                });
                const pubData = await pubRes.json();
                if (pubData.success) {
                    backdrop.remove();
                    showToast(`SOP published successfully as v${pubData.version}! 🎉`, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    throw new Error(pubData.error || 'Publish failed');
                }
            } catch (err) {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '🚀 Confirm Publish';
                showToast('Publish error: ' + err.message, 'warning');
            }
        });

    } catch (err) {
        const diffArea = document.getElementById('pub-diff-area');
        if (diffArea) diffArea.innerHTML = `<span style="color:#ef4444;">⚠️ Could not load diff: ${esc(err.message)}</span>`;
        const confirmBtn = document.getElementById('pub-confirm-btn');
        if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.style.cursor = 'pointer';
            confirmBtn.style.opacity = '1';
            confirmBtn.addEventListener('click', async () => {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Publishing…';
                try {
                    await saveDraftToServer();
                    const pubRes = await fetch(`/${SOP_LOB}/sop/publish`, { method: 'POST', credentials: 'same-origin' });
                    const pubData = await pubRes.json();
                    if (pubData.success) {
                        backdrop.remove();
                        showToast(`SOP published as v${pubData.version}! 🎉`, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else throw new Error(pubData.error || 'Publish failed');
                } catch (e) {
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '🚀 Confirm Publish';
                    showToast('Error: ' + e.message, 'warning');
                }
            });
        }
    }
}

// Initialization and DOM wireup
function initEditMode() {
    renderSopLayout();
    renderSidebar();

    document.getElementById('sop-undo-btn')?.addEventListener('click', undo);
    document.getElementById('sop-redo-btn')?.addEventListener('click', redo);
    document.getElementById('sop-options-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const drop = document.getElementById('sop-options-dropdown');
        if (drop) drop.style.display = drop.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('sop-save-layout-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('sop-save-layout-btn');
        const oldText = btn.innerHTML;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';
        await saveDraftToServer();
        btn.innerHTML = oldText;
        showToast('Draft saved successfully', 'success');
    });

    document.getElementById('sop-publish-btn')?.addEventListener('click', openPublishValidationModal);

    document.addEventListener('click', () => {
        const drop = document.getElementById('sop-options-dropdown');
        if (drop) drop.style.display = 'none';
    });

    // Wire up Enter key for AI Chat input
    const aiInput = document.getElementById('aiInput');
    if (aiInput) {
        aiInput.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendAiChatMessage();
            }
        });
    }

    // Set page data mode
    document.body.setAttribute('data-mode', 'edit');
    const style = document.createElement('style');
    style.textContent = `
        .sop-drag-ghost { opacity:.4; transform:rotate(1.5deg); }
        body[data-mode="edit"] .sop-card { cursor:grab; }
        body[data-mode="edit"] .sop-card:active { cursor:grabbing; }
    `;
    document.head.appendChild(style);
}

// Run boot operations
document.addEventListener('DOMContentLoaded', () => {
    if (SOP_MODE === 'edit') {
        (function loadSortable(cb) {
            if (window.Sortable) { cb(); return; }
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js';
            s.onload = cb;
            document.head.appendChild(s);
        })(initEditMode);
    } else if (SOP_MODE === 'preview') {
        // Readonly dynamic render of draft state for preview mode
        renderSopLayout();
        renderSidebar();
    }
});

</script>


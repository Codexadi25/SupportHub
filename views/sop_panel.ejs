<!-- ═══════════════════════════════════════════════════════════════════
     CORE SOP SCRIPTS
     ═══════════════════════════════════════════════════════════════════ -->
<script>
    /* ─ COMP CALCULATOR ──────────────────────────────────────────── */
    function runCalc() {
        const delay = parseInt(document.getElementById('calcDelay').value);
        const ov    = parseFloat(document.getElementById('calcOV').value);
        let comp = 0;
        if (!delay || !ov) { document.getElementById('finalComp').innerText = "₹0"; return; }
        if (delay > 30 && delay <= 45) {
            comp = ov < 50 ? ov : Math.max(50, Math.min(100, ov * 0.35));
        } else if (delay > 45) {
            comp = Math.min(500, ov);
        }
        document.getElementById('finalComp').innerText = "₹" + Math.round(comp);
    }

    /* ─ SEARCH ───────────────────────────────────────────────────── */
    function filterSOP() {
        const q = document.getElementById('sopSearch').value.toLowerCase();
        document.querySelectorAll('.sop-card').forEach(c => {
            const tags  = (c.dataset.tags || '').toLowerCase();
            const title = c.innerText.toLowerCase();
            c.style.display = (tags.includes(q) || title.includes(q)) ? '' : 'none';
        });
    }

    /* ─ COPY SCRIPT ──────────────────────────────────────────────── */
    function copyScript() {
        const t = "Hi, Good Morning Sir, My name is XYZ from Zomato. May I know the reason for the delay and by when the order will be delivered?";
        navigator.clipboard.writeText(t).then(() => showToast("Script copied!", "success"));
    }

    /* ─ SOP DETAIL MODAL ─────────────────────────────────────────── */
    function openModal(card) {
        const title      = card.querySelector('.card-header').innerText;
        const cond       = card.querySelector('.card-cond').innerText;
        const actionTag  = card.querySelector('.action-tag');
        const detailText = card.querySelector('.card-detail-data').innerText;
        const tagClass   = actionTag.className.replace('action-tag ', '');

        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalCond').innerText  = cond;

        const tagEl      = document.getElementById('modalTag');
        tagEl.innerText  = actionTag.innerText;
        tagEl.className  = 'modal-tag action-tag ' + tagClass;

        document.getElementById('modalBody').innerHTML = detailText
            .split('\n').map(line => {
                line = line.trim();
                if (!line) return '<br>';
                if (line.startsWith('•')) return '<span style="display:block;margin:4px 0;">• ' + line.slice(1).trim() + '</span>';
                if (/^(Case|Note|⚠️|Special|Example|Prompt|Important|Minor|Major)/i.test(line))
                    return '<strong style="display:block;margin-top:10px;">' + line + '</strong>';
                return '<span style="display:block;">' + line + '</span>';
            }).join('');

        document.getElementById('modalOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('modalOverlay').classList.remove('open');
        document.body.style.overflow = '';
    }

    function closeModalOutside(e) {
        if (e.target === document.getElementById('modalOverlay')) closeModal();
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeModal();
            closeViewersPanel();
        }
    });

    /* ─ TOAST ────────────────────────────────────────────────────── */
    function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast' + (type ? ' ' + type : '');
        void t.offsetWidth;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    /* ═══ G-SHEET SOURCE LINK ════════════════════════════════════════
       Stores the linked sheet URL in localStorage so it persists.
       Validates it's a real Google Sheets URL before saving.
    ═══════════════════════════════════════════════════════════════ */
    const SHEET_KEY = 'wimo_source_sheet_url';

    // Roles that can link/edit the sheet URL
    // Match exactly what SupportHub stores in user.role
    // Add/remove values here to match your actual role strings
    const SHEET_EDITOR_ROLES = [
        // Display labels (used when WIMO name popup is shown manually)
        'Admin', 'QA Analyst', 'Team Leader', 'Vendor',
        // Raw SupportHub role slugs (used when session is auto-filled)
        'admin', 'quality_analyst', 'qa_analyst', 'team_leader', 'teamlead', 'vendor'
    ];

    // Boot: restore saved URL on page load, enforce role permissions
    (function initSheetButton() {
        const saved = localStorage.getItem(SHEET_KEY);
        if (saved) applySheetUrl(saved, false);
        // Role check runs after myProfile is set (inside presence boot),
        // but we also enforce it here for immediate DOM state on reload.
        // The definitive enforcement is in openSheetModal() and applySheetUrl().
    })();

    function canEditSheet() {
        // myProfile.role is set after name modal; fallback checks button class
        if (typeof myProfile !== 'undefined' && myProfile && myProfile.role) {
            return SHEET_EDITOR_ROLES.includes(myProfile.role);
        }
        // Fallback: check if button has agent-readonly class (set by applySheetUrl)
        const btn = document.getElementById('pbSheetBtn');
        return btn && !btn.classList.contains('agent-readonly');
    }

    function openSheetModal() {
        // Block Agents from linking/editing
        if (!canEditSheet()) {
            const linked = !!localStorage.getItem(SHEET_KEY);
            if (linked) {
                // Agent can only open — send them directly to the sheet
                const url = localStorage.getItem(SHEET_KEY);
                window.open(url, '_blank');
            } else {
                showToast('Agents cannot link the source sheet.', 'warning');
            }
            return;
        }
        const saved = localStorage.getItem(SHEET_KEY) || '';
        const input = document.getElementById('smUrlInput');
        input.value = saved;
        onSheetUrlInput(saved);
        document.getElementById('sheetModalBackdrop').classList.add('open');
        setTimeout(() => input.focus(), 120);
    }

    function closeSheetModal() {
        document.getElementById('sheetModalBackdrop').classList.remove('open');
    }

    function closeSheetModalOutside(e) {
        if (e.target === document.getElementById('sheetModalBackdrop')) closeSheetModal();
    }

    function onSheetUrlInput(val) {
        val = val.trim();
        const valid    = isValidSheetUrl(val);
        const hasVal   = val.length > 0;
        const saveBtn  = document.getElementById('smSaveBtn');
        const preview  = document.getElementById('smPreview');
        const prevText = document.getElementById('smPreviewText');
        const clearBtn = document.getElementById('smClear');
        const openBtn  = document.getElementById('smOpenBtn');

        saveBtn.disabled = !valid;

        if (valid) {
            const name = extractSheetName(val);
            prevText.textContent = name ? '"' + name + '" — valid Google Sheets URL ✓' : 'Valid Google Sheets URL ✓';
            preview.classList.add('show');
            openBtn.href = val;
            openBtn.style.display = 'flex';
        } else {
            preview.classList.remove('show');
            openBtn.style.display = 'none';
        }

        clearBtn.classList.toggle('show', hasVal && !!localStorage.getItem(SHEET_KEY));
    }

    // NOTE: saveSheetUrl is defined further below (API version that also saves to server)


    function clearSheetUrl() {
        if (!confirm('Remove the linked source sheet?')) return;
        localStorage.removeItem(SHEET_KEY);
        document.getElementById('smUrlInput').value = '';
        onSheetUrlInput('');
        applySheetUrl(null, false);
        closeSheetModal();
        showToast('Source sheet removed');
    }

    function applySheetUrl(url, animate) {
        const btn   = document.getElementById('pbSheetBtn');
        const dot   = document.getElementById('pbSheetDot');
        const label = document.getElementById('pbSheetLabel');
        const isEditor = canEditSheet();

        if (!isEditor) {
            btn.classList.add('agent-readonly');
            btn.title = url
                ? 'Open source Google Sheet (view only)'
                : 'Source sheet — linking restricted to QA Analyst, Team Leader, Vendor, Admin';
        } else {
            btn.classList.remove('agent-readonly');
        }

        if (url) {
            btn.onclick = null;
            btn.setAttribute('data-linked', 'true');
            btn.classList.add('linked');
            btn.addEventListener('click', handleSheetBtnClick, { once: false });
            dot.classList.add('show');
            label.textContent = 'Source Sheet';
            if (!isEditor) {
                btn.title = 'Open source Google Sheet (view only)';
            } else {
                btn.title = 'Open source Google Sheet (right-click to change URL)';
            }
            if (animate) {
                btn.style.transform = 'scale(1.08)';
                setTimeout(() => btn.style.transform = '', 300);
            }
        } else {
            btn.onclick = openSheetModal;
            btn.removeEventListener('click', handleSheetBtnClick);
            btn.setAttribute('data-linked', 'false');
            btn.classList.remove('linked');
            dot.classList.remove('show');
            label.textContent = 'Source Sheet';
        }
    }

    function handleSheetBtnClick(e) {
        const url = localStorage.getItem(SHEET_KEY);
        if (!url) { openSheetModal(); return; }
        if (e.ctrlKey || e.metaKey || e.shiftKey) {
            e.preventDefault();
            openSheetModal();
        } else {
            window.open(url, '_blank');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('pbSheetBtn');
        btn.addEventListener('contextmenu', function(e) {
            if (localStorage.getItem(SHEET_KEY)) {
                e.preventDefault();
                openSheetModal();
            }
        });
    });

    function isValidSheetUrl(url) {
        if (!url) return false;
        try {
            const u = new URL(url);
            return u.hostname === 'docs.google.com' && u.pathname.includes('/spreadsheets/');
        } catch(_) {
            return false;
        }
    }

    function extractSheetName(url) {
        try {
            const u = new URL(url);
            const title = u.searchParams.get('title') || u.searchParams.get('rm');
            if (title) return decodeURIComponent(title);
        } catch(_) {}
        return null;
    }
</script>

<script>
    let panelOpen = false;
    window.toggleViewersPanel = function() {
        panelOpen = !panelOpen;
        document.getElementById("viewersPanel").classList.toggle("open", panelOpen);
    };

    function closeViewersPanel() {
        panelOpen = false;
        document.getElementById("viewersPanel").classList.remove("open");
    }

    document.addEventListener("click", e => {
        if (!e.target.closest("#viewersPanel") &&
            !e.target.closest("[onclick='toggleViewersPanel()']") &&
            !e.target.closest(".pb-see-all") &&
            !e.target.closest(".pb-you-chip") &&
            !e.target.closest(".pb-overflow")) {
            closeViewersPanel();
        }
    });

    function getInitials(name) {
        if (!name?.trim()) return "?";
        const p = name.trim().split(/\s+/);
        return p.length === 1
            ? p[0].substring(0, 2).toUpperCase()
            : (p[0][0] + p[p.length - 1][0]).toUpperCase();
    }

    const PALETTE = [
        "#CB202D","#1565C0","#2E7D32","#6A1B9A",
        "#C62828","#00695C","#E65100","#283593",
        "#4E342E","#37474F"
    ];

    function nameToColor(name) {
        if (!name) return PALETTE[0];
        let h = 0;
        for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
        return PALETTE[Math.abs(h) % PALETTE.length];
    }

    function genId() {
        return "u_" + Math.random().toString(36).slice(2, 9) + "_" + Date.now().toString(36);
    }

    function timeSince(ts) {
        if (!ts) return "";
        const s = Math.floor((Date.now() - ts) / 1000);
        if (s < 10)   return "just now";
        if (s < 60)   return s + "s ago";
        if (s < 3600) return Math.floor(s / 60) + "m ago";
        return Math.floor(s / 3600) + "h ago";
    }

    function esc(str) {
        return String(str || "")
            .replace(/&/g,"&amp;").replace(/</g,"&lt;")
            .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
    }
</script>

<script>
// ─────────────────────────────────────────────────────────────────────
// SOP EDITOR & DRAFT SYSTEM
// ─────────────────────────────────────────────────────────────────────
const SOP_MODE = '<%= typeof mode !== "undefined" ? mode : "view" %>';
const SOP_LOB  = window.__sopLob || 'zomato';

// Initialize Draft State
window.SopDraftState = {
    template: <%- JSON.stringify(template || { sidebarConfig: {}, categories: [] }) %>,
    cards: <%- JSON.stringify((categories || []).reduce((acc, cat) => {
        const items = (cat.items || []).map(card => ({
            _id: card._id ? card._id.toString() : 'new_' + Math.random().toString(36).substring(2, 9),
            category: card.category || cat.title,
            title: card.title || '',
            condition: card.condition || '',
            action: card.action || 'Wait',
            details: card.details || '',
            tags: card.tags || [],
            order: card.order || 0
        }));
        return acc.concat(items);
    }, [])) %>
};

// Undo/Redo Stacks
window.undoStack = [];
window.redoStack = [];

function pushState() {
    window.undoStack.push(JSON.stringify(window.SopDraftState));
    window.redoStack = [];
    updateUndoRedoButtons();
}

function undo() {
    if (window.undoStack.length === 0) return;
    window.redoStack.push(JSON.stringify(window.SopDraftState));
    window.SopDraftState = JSON.parse(window.undoStack.pop());
    renderSopLayout();
    renderSidebar();
    updateUndoRedoButtons();
    triggerAutoSave();
}

function redo() {
    if (window.redoStack.length === 0) return;
    window.undoStack.push(JSON.stringify(window.SopDraftState));
    window.SopDraftState = JSON.parse(window.redoStack.pop());
    renderSopLayout();
    renderSidebar();
    updateUndoRedoButtons();
    triggerAutoSave();
}

function updateUndoRedoButtons() {
    const uBtn = document.getElementById('sop-undo-btn');
    const rBtn = document.getElementById('sop-redo-btn');
    if (uBtn) uBtn.disabled = window.undoStack.length === 0;
    if (rBtn) rBtn.disabled = window.redoStack.length === 0;
}

// Render Categories & Cards
function renderSopLayout() {
    const container = document.getElementById('sopDynamicContainer');
    if (!container) return;
    container.innerHTML = '';

    const cards = [...(window.SopDraftState.cards || [])];
    
    // Inject Removed Placeholders for Diff View
    if (window.diffSnapshotData) {
        const snapCards = window.diffSnapshotData.cards || [];
        snapCards.forEach(sc => {
            const exists = cards.some(c => c.title.toLowerCase().trim() === sc.title.toLowerCase().trim());
            if (!exists) {
                cards.push({
                    _id: 'removed_' + sc._id,
                    category: sc.category,
                    title: sc.title,
                    condition: sc.condition,
                    action: sc.action,
                    details: sc.details,
                    tags: sc.tags,
                    isRemovedPlaceholder: true
                });
            }
        });
    }

    const categoriesMap = {};
    cards.forEach(c => {
        const cat = c.category || 'General';
        if (!categoriesMap[cat]) categoriesMap[cat] = [];
        categoriesMap[cat].push(c);
    });

    const tempCats = window.SopDraftState.template.categories || [];
    const sortedCategories = Object.keys(categoriesMap).map(title => {
        const config = tempCats.find(c => c.name.toLowerCase().trim() === title.toLowerCase().trim());
        return {
            title,
            items: categoriesMap[title].sort((a,b) => (a.order || 0) - (b.order || 0)),
            phase: config ? config.phase : '',
            order: config ? config.order : 999
        };
    }).sort((a, b) => a.order - b.order);

    if (sortedCategories.length === 0) {
        container.innerHTML = `<div style="padding:40px;text-align:center;color:#999;font-style:italic;">No SOP categories found. Click "Add Category" or link a spreadsheet.</div>`;
        return;
    }

    sortedCategories.forEach(cat => {
        const block = document.createElement('div');
        block.className = 'category-block';
        block.setAttribute('data-category', cat.title);

        const titleDiv = document.createElement('div');
        titleDiv.className = 'category-title';
        titleDiv.innerHTML = `
            <div style="display:flex; align-items:center; gap:10px;">
                <span class="cat-name-span">${esc(cat.title)}</span>
                ${cat.phase ? `<span style="font-size:0.8rem; font-weight:normal; color:#686B78;">(Phase: ${esc(cat.phase)})</span>` : ''}
            </div>
            ${SOP_MODE === 'edit' ? `
                <div style="display:flex; gap:6px;">
                    <button class="sop-toolbar-btn btn-slate" style="padding:2px 8px; font-size:10px;" onclick="editCategoryName('${esc(cat.title)}')">✏️ Rename</button>
                    <button class="sop-toolbar-btn btn-red" style="padding:2px 8px; font-size:10px;" onclick="deleteCategory('${esc(cat.title)}')">🗑 Delete</button>
                </div>
            ` : ''}
        `;
        block.appendChild(titleDiv);

        const grid = document.createElement('div');
        grid.className = 'sop-grid';
        grid.setAttribute('data-category-grid', cat.title);

        if (cat.items && cat.items.length > 0) {
            cat.items.forEach(card => {
                const cardDiv = document.createElement('div');
                cardDiv.className = 'sop-card';
                cardDiv.setAttribute('data-sop-id', card._id);
                cardDiv.setAttribute('data-tags', (card.tags || []).join(' '));

                let badgeHtml = '';

                // Reconciliation check
                if (window.sheetReconciliationData) {
                    const match = window.sheetReconciliationData.find(r => r.title.toLowerCase().trim() === card.title.toLowerCase().trim());
                    if (match) {
                        if (match.mismatch) {
                            cardDiv.className += ' sync-mismatch';
                            badgeHtml = `<span class="sync-badge sync-badge-mismatch">⚠️ Caution: Mismatch</span>`;
                        } else {
                            cardDiv.className += ' sync-match';
                            badgeHtml = `<span class="sync-badge sync-badge-match">Sync Match</span>`;
                        }
                    } else {
                        cardDiv.className += ' sync-missing';
                        badgeHtml = `<span class="sync-badge sync-badge-missing">⚠️ Not in Sheet</span>`;
                    }
                }

                // Diff check
                if (window.diffSnapshotData) {
                    if (card.isRemovedPlaceholder) {
                        cardDiv.className += ' diff-removed';
                        badgeHtml = `<span class="sync-badge" style="background:#fee2e2; color:#b91c1c; border:1px solid #b91c1c">Removed</span>`;
                    } else {
                        const status = getCardDiffStatus(card);
                        if (status) {
                            cardDiv.className += ' ' + status.className;
                            badgeHtml = `<span class="sync-badge" style="background:${status.bg}; color:${status.color}; border:1px solid ${status.color}">${status.label}</span>`;
                        }
                    }
                }

                let actionClass = 'tag-wait';
                const actLower = (card.action || '').toLowerCase();
                if (actLower.includes('cancel')) actionClass = 'tag-cancel';
                else if (actLower.includes('escalate') || actLower.includes('check')) actionClass = 'tag-esc';

                cardDiv.innerHTML = `
                    ${badgeHtml}
                    <div class="card-header">${esc(card.title)}</div>
                    <div class="card-cond">${esc(card.condition)}</div>
                    <span class="action-tag ${actionClass}">${esc(card.action)}</span>
                    <div class="expand-hint"><i class="fa fa-expand"></i> View full SOP</div>
                    <div class="card-detail-data" style="display:none">${esc(card.details)}</div>
                    ${SOP_MODE === 'edit' && !card.isRemovedPlaceholder ? `
                        <div class="sop-card-controls" style="position:absolute; top:6px; right:6px; display:flex; gap:4px; z-index:10;">
                            <button class="sop-edit-btn" title="Edit this SOP block" style="background:rgba(37,99,235,.1);border:1px solid #2563eb;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:12px;" onclick="event.stopPropagation(); openBlockEditModal('${card._id}')">✏️</button>
                            <button class="sop-del-btn" title="Delete this SOP block" style="background:rgba(220,38,38,.1);border:1px solid #dc2626;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:12px;" onclick="event.stopPropagation(); deleteBlock('${card._id}')">🗑</button>
                        </div>
                    ` : ''}
                `;

                if (!card.isRemovedPlaceholder) {
                    cardDiv.addEventListener('click', () => openModal(cardDiv));
                }
                grid.appendChild(cardDiv);
            });
        } else {
            grid.innerHTML = `<div style="padding:15px;color:#999;font-style:italic;font-size:0.8rem;">No blocks in this category</div>`;
        }

        block.appendChild(grid);

        if (SOP_MODE === 'edit') {
            const addBlockBtn = document.createElement('button');
            addBlockBtn.className = 'sop-add-block-btn';
            addBlockBtn.textContent = '＋ Add Block';
            addBlockBtn.style.cssText = 'display:block;width:100%;margin:8px 0 16px;padding:8px;background:#f0f7ff;border:1.5px dashed #2563eb;border-radius:8px;color:#2563eb;font-weight:700;cursor:pointer;font-size:13px;';
            addBlockBtn.addEventListener('click', () => openBlockCreateModal(cat.title));
            block.appendChild(addBlockBtn);
        }

        container.appendChild(block);
    });

    if (SOP_MODE === 'edit') {
        enableDragSort();
    }
}

// Render Sidebar Widgets
function renderSidebar() {
    const container = document.getElementById('sopSidebarContainer');
    if (!container) return;
    container.innerHTML = '';

    const config = window.SopDraftState.template.sidebarConfig || {};

    if (SOP_MODE === 'edit') {
        const custBtn = document.createElement('button');
        custBtn.className = 'sop-toolbar-btn btn-purple';
        custBtn.style.cssText = 'width:100%; margin-bottom:12px; justify-content:center;';
        custBtn.innerHTML = '⚙️ Customize Sidebar & Header';
        custBtn.onclick = openCustomizeSidebarModal;
        container.appendChild(custBtn);
    }

    if (config.calculator !== false) {
        const calcWidget = document.createElement('div');
        calcWidget.className = 'widget';
        calcWidget.innerHTML = `
            <div class="widget-title">🧮 Compensation Calculator</div>
            <div class="comp-calc">
                <input type="number" id="calcDelay" placeholder="Delay in minutes" oninput="runCalc()">
                <input type="number" id="calcOV" placeholder="Order Value (₹)" oninput="runCalc()">
                <div class="calc-result">
                    <div style="font-size:0.8rem;color:#686B78;margin-bottom:5px;">Compensation Amount</div>
                    <div id="finalComp">₹0</div>
                </div>
            </div>
        `;
        container.appendChild(calcWidget);
    }

    if (config.callingScript) {
        const scriptWidget = document.createElement('div');
        scriptWidget.className = 'widget';
        scriptWidget.innerHTML = `
            <div class="widget-title">📞 Calling Script</div>
            <div class="script-box" onclick="copyScript(this)">${esc(config.callingScript)}</div>
            <p class="tooltip">Click to copy script</p>
        `;
        container.appendChild(scriptWidget);
    }

    if (config.quickPrompts && config.quickPrompts.length > 0) {
        const promptsWidget = document.createElement('div');
        promptsWidget.className = 'widget';
        promptsWidget.innerHTML = `<div class="widget-title">💬 Quick Prompts</div>`;
        const ul = document.createElement('ul');
        ul.className = 'updates-list';
        config.quickPrompts.forEach(p => {
            const li = document.createElement('li');
            li.style.cssText = 'cursor:pointer; padding:6px 10px; border-bottom:1px solid #f1f5f9;';
            li.innerHTML = `<strong>${esc(p.label)}:</strong> <span class="prompt-text">${esc(p.text)}</span>`;
            li.onclick = () => {
                navigator.clipboard.writeText(p.text).then(() => showToast("Prompt copied!", "success"));
            };
            ul.appendChild(li);
        });
        promptsWidget.appendChild(ul);
        container.appendChild(promptsWidget);
    }

    if (config.recentUpdates && config.recentUpdates.length > 0) {
        const updatesWidget = document.createElement('div');
        updatesWidget.className = 'widget';
        updatesWidget.innerHTML = `<div class="widget-title">🔔 Recent Updates</div>`;
        const ul = document.createElement('ul');
        ul.className = 'updates-list';
        config.recentUpdates.forEach(up => {
            const li = document.createElement('li');
            li.innerHTML = `<strong>${esc(up.date)}:</strong> ${esc(up.text)}`;
            ul.appendChild(li);
        });
        updatesWidget.appendChild(ul);
        container.appendChild(updatesWidget);
    }
}

function copyScript(el) {
    navigator.clipboard.writeText(el.innerText.trim()).then(() => showToast("Script copied!", "success"));
}

// Category CRUD
function editCategoryName(oldName) {
    const newName = prompt(`Rename category "${oldName}" to:`, oldName);
    if (!newName || newName.trim() === '' || newName.trim() === oldName) return;
    pushState();
    const tempCats = window.SopDraftState.template.categories || [];
    const cat = tempCats.find(c => c.name.toLowerCase().trim() === oldName.toLowerCase().trim());
    if (cat) cat.name = newName.trim();
    window.SopDraftState.cards.forEach(c => {
        if (c.category.toLowerCase().trim() === oldName.toLowerCase().trim()) c.category = newName.trim();
    });
    renderSopLayout();
    showToast('Category renamed ✓', 'success');
    triggerAutoSave();
}

function deleteCategory(catName) {
    if (!confirm(`Delete category "${catName}" and all of its cards?`)) return;
    pushState();
    window.SopDraftState.template.categories = (window.SopDraftState.template.categories || []).filter(c => c.name.toLowerCase().trim() !== catName.toLowerCase().trim());
    window.SopDraftState.cards = (window.SopDraftState.cards || []).filter(c => c.category.toLowerCase().trim() !== catName.toLowerCase().trim());
    renderSopLayout();
    showToast('Category deleted', 'success');
    triggerAutoSave();
}

function openCategoryModal() {
    const name = prompt('New Category Name:');
    if (!name || !name.trim()) return;
    pushState();
    const tempCats = window.SopDraftState.template.categories || [];
    tempCats.push({ name: name.trim(), phase: '', order: tempCats.length });
    renderSopLayout();
    showToast('Category added ✓', 'success');
    triggerAutoSave();
}

// Card CRUD (Local)
function openBlockCreateModal(category) {
    const backdrop = buildBackdrop('sopBlockBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:560px;max-width:97%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative; font-family:inherit;">
            <button onclick="document.getElementById('sopBlockBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1rem;color:#2563eb;">＋ New Block in "${esc(category)}"</h3>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TITLE</label>
            <input id="nb-title" type="text" placeholder="Scenario title" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">CONDITION / TRIGGER</label>
            <input id="nb-cond" type="text" placeholder="When does this apply?" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">ACTION</label>
            <input id="nb-action" type="text" placeholder="e.g. Wait, Cancel, Escalate" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">FULL DETAILS</label>
            <textarea id="nb-details" rows="5" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.85rem;resize:vertical;margin-bottom:12px;"></textarea>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TAGS (comma-separated)</label>
            <input id="nb-tags" type="text" placeholder="delay, restaurant" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:16px;">
            <button id="saveBlockBtn" style="width:100%;padding:11px;background:#2563eb;color:#fff;border:none;border-radius:8px;font-weight:800;font-family:inherit;cursor:pointer;font-size:.9rem;">Create Block</button>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    document.getElementById('saveBlockBtn').addEventListener('click', () => {
        const title = document.getElementById('nb-title').value.trim();
        const condition = document.getElementById('nb-cond').value.trim();
        const action = document.getElementById('nb-action').value.trim();
        const details = document.getElementById('nb-details').value;
        const tags = document.getElementById('nb-tags').value;
        if (!title) { showToast('Title required', 'warning'); return; }

        pushState();
        const newCard = {
            _id: 'new_' + Math.random().toString(36).substring(2, 9),
            category, title, condition, action: action || 'Wait', details,
            tags: tags.split(',').map(t => t.trim()).filter(Boolean),
            order: (window.SopDraftState.cards || []).filter(c => c.category === category).length
        };
        window.SopDraftState.cards.push(newCard);
        renderSopLayout();
        backdrop.remove();
        showToast('Block created ✓', 'success');
        triggerAutoSave();
    });
}

function openBlockEditModal(cardId) {
    const card = window.SopDraftState.cards.find(c => c._id === cardId);
    if (!card) return;

    const backdrop = buildBackdrop('sopEditBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:580px;max-width:97%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative; font-family:inherit;">
            <button onclick="document.getElementById('sopEditBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1rem;color:#CB202D;">✏️ Edit SOP Block</h3>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TITLE</label>
            <input id="se-title" type="text" value="${esc(card.title)}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">CONDITION / TRIGGER</label>
            <input id="se-cond" type="text" value="${esc(card.condition)}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">ACTION</label>
            <input id="se-action" type="text" value="${esc(card.action)}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:12px;">
            <div style="margin-bottom:12px;">
                <label style="font-size:.75rem;font-weight:700;color:#64748b;display:flex;justify-content:between;align-items:center;margin-bottom:4px;">
                    FULL DETAILS
                    <button class="sop-toolbar-btn btn-purple" style="padding:2px 8px; font-size:10px; margin-left:auto;" onclick="askAiToHelpDetails()">✨ Ask AI</button>
                </label>
                <textarea id="se-details" rows="7" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.85rem;resize:vertical;">${esc(card.details)}</textarea>
            </div>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TAGS</label>
            <input id="se-tags" type="text" value="${esc((card.tags || []).join(', '))}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:16px;">
            <div style="display:flex;gap:10px;">
                <button id="seSubmitBtn" style="flex:2;padding:11px;background:#CB202D;color:#fff;border:none;border-radius:8px;font-weight:800;font-family:inherit;cursor:pointer;font-size:.9rem;">Save Changes</button>
                <button id="seDeleteBtn" style="flex:1;padding:11px;background:#ffefef;color:#b23a3a;border:1px solid #fca5a5;border-radius:8px;font-weight:700;font-family:inherit;cursor:pointer;font-size:.85rem;">Delete</button>
            </div>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    document.getElementById('seSubmitBtn').addEventListener('click', () => {
        const title = document.getElementById('se-title').value.trim();
        const cond = document.getElementById('se-cond').value.trim();
        const action = document.getElementById('se-action').value.trim();
        const details = document.getElementById('se-details').value;
        const tags = document.getElementById('se-tags').value;
        if (!title) { showToast('Title required', 'warning'); return; }

        pushState();
        card.title = title;
        card.condition = cond;
        card.action = action;
        card.details = details;
        card.tags = tags.split(',').map(t => t.trim()).filter(Boolean);
        renderSopLayout();
        backdrop.remove();
        showToast('Block updated ✓', 'success');
        triggerAutoSave();
    });

    document.getElementById('seDeleteBtn').addEventListener('click', () => {
        backdrop.remove();
        deleteBlock(cardId);
    });
}

function deleteBlock(cardId) {
    if (!confirm('Delete this SOP block permanently?')) return;
    pushState();
    window.SopDraftState.cards = window.SopDraftState.cards.filter(c => c._id !== cardId);
    renderSopLayout();
    showToast('Block deleted', 'success');
    triggerAutoSave();
}

async function askAiToHelpDetails() {
    const title = document.getElementById('se-title').value.trim();
    const cond = document.getElementById('se-cond').value.trim();
    if (!title) { showToast('Title required first', 'warning'); return; }

    const btn = document.querySelector('[onclick="askAiToHelpDetails()"]');
    const oldHtml = btn.innerHTML;
    btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Writing...';
    btn.disabled = true;

    try {
        const res = await fetch(`/${SOP_LOB}/sop/chat`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                message: `Generate detailed bullet points (start each bullet with '•') for a Zomato WIMO SOP card. Title: "${title}", Trigger/Condition: "${cond}". Give just the bullet points without any introductory or concluding text.`,
                context: { title, condition: cond }
            })
        });
        const data = await res.json();
        if (data.success && data.reply) {
            document.getElementById('se-details').value = data.reply;
            showToast('AI suggestion generated!', 'success');
        } else {
            throw new Error(data.error || 'AI request failed');
        }
    } catch (err) {
        showToast('AI Error: ' + err.message, 'warning');
    } finally {
        btn.innerHTML = oldHtml;
        btn.disabled = false;
    }
}

// Drag sorting order sync
function enableDragSort() {
    document.querySelectorAll('.sop-grid').forEach(grid => {
        if (window.Sortable) {
            new Sortable(grid, {
                animation: 150,
                handle: '.sop-card',
                ghostClass: 'sop-drag-ghost',
                onEnd() {
                    pushState();
                    syncDragOrderToState();
                    highlightSaveBtn();
                    triggerAutoSave();
                }
            });
        }
    });
}

function syncDragOrderToState() {
    const updatedCards = [];
    document.querySelectorAll('.category-block').forEach(section => {
        const category = section.getAttribute('data-category');
        let cardOrder = 0;
        section.querySelectorAll('.sop-card').forEach(cardEl => {
            const id = cardEl.getAttribute('data-sop-id');
            const cardObj = window.SopDraftState.cards.find(c => c._id === id);
            if (cardObj) {
                cardObj.category = category;
                cardObj.order = cardOrder++;
                updatedCards.push(cardObj);
            }
        });
    });
    const processedIds = updatedCards.map(c => c._id);
    const orphans = window.SopDraftState.cards.filter(c => !processedIds.includes(c._id));
    window.SopDraftState.cards = updatedCards.concat(orphans);
}

function highlightSaveBtn() {
    const btn = document.getElementById('sop-save-layout-btn');
    if (btn) {
        btn.style.background = '#dc2626';
        btn.innerHTML = '💾 Save Changes!';
    }
}

// Auto-Save
let autoSaveTimer = null;
function triggerAutoSave() {
    const statusMsg = document.getElementById('draft-status-msg');
    if (statusMsg) {
        statusMsg.textContent = 'Saving draft...';
        statusMsg.style.color = '#f5a623';
    }
    if (autoSaveTimer) clearTimeout(autoSaveTimer);
    autoSaveTimer = setTimeout(saveDraftToServer, 3000);
}

async function saveDraftToServer() {
    try {
        const res = await fetch(`/${SOP_LOB}/sop/draft`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                template: window.SopDraftState.template,
                cards: window.SopDraftState.cards
            })
        });
        const data = await res.json();
        if (data.success) {
            const statusMsg = document.getElementById('draft-status-msg');
            if (statusMsg) {
                statusMsg.textContent = 'Draft auto-saved ✓';
                statusMsg.style.color = '#a7f3d0';
            }
            const btn = document.getElementById('sop-save-layout-btn');
            if (btn) {
                btn.style.background = '#475569';
                btn.innerHTML = '💾 Save Draft';
            }
        }
    } catch (err) {
        console.error('Auto-save error:', err);
        const statusMsg = document.getElementById('draft-status-msg');
        if (statusMsg) {
            statusMsg.textContent = 'Failed to auto-save';
            statusMsg.style.color = '#fca5a5';
        }
    }
}


            applySheetUrl(url, true);
            closeSheetModal();
            showToast('Source sheet linked successfully ✓', 'success');
        } else {
            throw new Error(data.error || 'Save failed');
        }
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}


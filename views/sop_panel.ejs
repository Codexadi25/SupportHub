            <span id="pbSheetLabel">Source Sheet</span>
            <div class="pb-sheet-linked-dot" id="pbSheetDot"></div>
        </button>
    </div>
</div>

<!-- ═══ G-SHEET SOURCE MODAL ══════════════════════════════════════════ -->
<div class="sheet-modal-backdrop" id="sheetModalBackdrop" onclick="closeSheetModalOutside(event)">
    <div class="sheet-modal">
        <button class="sm-close" onclick="closeSheetModal()">✕</button>

        <div class="sm-header">
            <div class="sm-icon-wrap">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <rect x="2" y="1" width="15" height="18" rx="2" fill="#34a853"/>
                    <path d="M12 1v5h5" fill="none" stroke="#fff" stroke-width="1.1" opacity="0.6"/>
                    <path d="M12 1l5 5H12V1z" fill="#1e8c45"/>
                    <rect x="4.5" y="8"  width="10" height="1.1" rx="0.5" fill="#fff" opacity="0.9"/>
                    <rect x="4.5" y="11" width="10" height="1.1" rx="0.5" fill="#fff" opacity="0.9"/>

    messages.appendChild(uMsg);
    input.value = '';
    messages.scrollTop = messages.scrollHeight;

    const bLoading = document.createElement('div');
    bLoading.className = 'ai-msg bot';
    bLoading.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Thinking...';
    messages.appendChild(bLoading);
    messages.scrollTop = messages.scrollHeight;

    sendBtn.disabled = true;
    try {
        const res = await fetch(`/${SOP_LOB}/sop/chat`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ message: text, context: { draftState: window.SopDraftState } })
        });
        const data = await res.json();
        if (data.success && data.reply) {
            bLoading.innerText = data.reply;
        } else {
            throw new Error(data.error || 'Failed');
        }
    } catch (err) {
        bLoading.innerText = 'AI Error: ' + err.message;
    } finally {
        sendBtn.disabled = false;
        messages.scrollTop = messages.scrollHeight;
    }
}

// ─── MISSING HELPER FUNCTIONS ────────────────────────────────────────

/**
 * Build a full-screen backdrop div for modals.
 * Removes any existing backdrop with the same id first.
 */
function buildBackdrop(id) {
    const existing = document.getElementById(id);
    if (existing) existing.remove();
    const backdrop = document.createElement('div');
    backdrop.id = id;
    backdrop.style.cssText = [
        'position:fixed', 'inset:0', 'background:rgba(0,0,0,0.55)',
        'z-index:8000', 'display:flex', 'align-items:center',
        'justify-content:center', 'backdrop-filter:blur(3px)',
        'animation:fadeIn .15s ease'
    ].join(';');
    return backdrop;
}

/**
 * Copy the text of a quick-prompt item to clipboard.
 */
function copyPromptText(el) {
    const textEl = el.querySelector('.prompt-text');
    const text = textEl ? textEl.innerText : el.innerText;
    navigator.clipboard.writeText(text)
        .then(() => showToast('Prompt copied!', 'success'))
        .catch(() => showToast('Copy failed', 'warning'));
}

/**
 * Open a publish validation/confirmation modal that shows a diff summary
 * before finally calling the publish API.
 */
async function openPublishValidationModal() {
    const backdrop = buildBackdrop('sopPublishBackdrop');

    // Build placeholder modal first so user sees it immediately
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:560px;max-width:97%;max-height:88vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.28);position:relative;font-family:inherit;">
            <button onclick="document.getElementById('sopPublishBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;color:#64748b;">✕</button>
            <h3 style="margin:0 0 8px;font-size:1.1rem;color:#1e293b;display:flex;align-items:center;gap:8px;">
                🚀 Publish SOP Draft
            </h3>
            <p style="font-size:0.82rem;color:#64748b;margin:0 0 18px;line-height:1.5;">
                Publishing will replace the <strong>live SOP</strong> with your current draft.
                This action will be logged in version history and <strong>cannot be undone</strong> (but can be rolled back).
            </p>
            <div id="pub-diff-area" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:14px;font-size:0.82rem;max-height:280px;overflow-y:auto;margin-bottom:18px;">
                <i class="fa fa-spinner fa-spin"></i> Loading change summary…
            </div>
            <div style="display:flex;gap:10px;margin-top:4px;">
                <button onclick="document.getElementById('sopPublishBackdrop').remove()" style="flex:1;padding:11px;background:#f5f5f5;border:1px solid #e0e0e0;border-radius:8px;font-size:.88rem;font-weight:700;font-family:inherit;cursor:pointer;color:#64748b;">Cancel</button>
                <button id="pub-confirm-btn" disabled style="flex:2;padding:11px;background:#16a34a;color:#fff;border:none;border-radius:8px;font-size:.88rem;font-weight:800;font-family:inherit;cursor:not-allowed;opacity:0.5;display:flex;align-items:center;justify-content:center;gap:7px;">
                    🚀 Confirm Publish
                </button>
            </div>
            <p id="pub-policy-warn" style="margin:10px 0 0;font-size:0.72rem;color:#e65100;text-align:center;display:none;">
                ⚠️ Ensure all changes comply with company policies before publishing.
            </p>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    // Fetch live data to compute diff
    try {
        const res = await fetch(`/${SOP_LOB}/sop/live`);
        const data = await res.json();
        const diffArea = document.getElementById('pub-diff-area');
        const confirmBtn = document.getElementById('pub-confirm-btn');
        const policyWarn = document.getElementById('pub-policy-warn');

        if (!data.success) throw new Error(data.error || 'Failed to load live SOP');

        const liveCards = data.cards || [];
        const draftCards = window.SopDraftState.cards || [];

        // Compute changes
        const added = [];
        const removed = [];
        const modified = [];

        draftCards.forEach(dc => {
            const match = liveCards.find(lc => lc._id && dc._id && String(lc._id) === String(dc._id));
            if (!match) {
                const titleMatch = liveCards.find(lc => lc.title?.toLowerCase() === dc.title?.toLowerCase());
                if (!titleMatch) added.push(dc.title);
                else {
                    if (titleMatch.condition !== dc.condition || titleMatch.action !== dc.action || titleMatch.details !== dc.details)
                        modified.push(dc.title);
                }
            } else {
                if (match.title !== dc.title || match.condition !== dc.condition || match.action !== dc.action || match.details !== dc.details)
                    modified.push(dc.title || match.title);
            }
        });

        liveCards.forEach(lc => {
            const stillExists = draftCards.find(dc =>
                (dc._id && lc._id && String(dc._id) === String(lc._id)) ||
                dc.title?.toLowerCase() === lc.title?.toLowerCase()
            );
            if (!stillExists) removed.push(lc.title);
        });

        const total = added.length + removed.length + modified.length;

        if (total === 0) {
            diffArea.innerHTML = `<span style="color:#16a34a;">✓ No content changes detected. Template/sidebar config may have changed.</span>`;
        } else {
            let html = `<strong style="color:#1e293b;">${total} change${total > 1 ? 's' : ''} detected:</strong><ul style="margin:8px 0 0;padding-left:18px;line-height:1.8;">`;
            added.forEach(t => { html += `<li style="color:#15803d;">➕ Added: <em>${esc(t)}</em></li>`; });
            modified.forEach(t => { html += `<li style="color:#1d4ed8;">✏️ Modified: <em>${esc(t)}</em></li>`; });
            removed.forEach(t => { html += `<li style="color:#b91c1c;text-decoration:line-through;">🗑 Removed: <em>${esc(t)}</em></li>`; });
            html += '</ul>';
            diffArea.innerHTML = html;
        }

        // Enable confirm button
        confirmBtn.disabled = false;
        confirmBtn.style.cursor = 'pointer';
        confirmBtn.style.opacity = '1';
        if (policyWarn) policyWarn.style.display = 'block';

        confirmBtn.addEventListener('click', async () => {
            confirmBtn.disabled = true;
            confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Publishing…';
            try {
                // First save the latest draft state
                await saveDraftToServer();

                const pubRes = await fetch(`/${SOP_LOB}/sop/publish`, {
                    method: 'POST',
                    credentials: 'same-origin'
                });
                const pubData = await pubRes.json();
                if (pubData.success) {
                    backdrop.remove();
                    showToast(`SOP published successfully as v${pubData.version}! 🎉`, 'success');
                    setTimeout(() => location.reload(), 1500);
                } else {
                    throw new Error(pubData.error || 'Publish failed');
                }
            } catch (err) {
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = '🚀 Confirm Publish';
                showToast('Publish error: ' + err.message, 'warning');
            }
        });

    } catch (err) {
        const diffArea = document.getElementById('pub-diff-area');
        if (diffArea) diffArea.innerHTML = `<span style="color:#ef4444;">⚠️ Could not load diff: ${esc(err.message)}</span>`;
        const confirmBtn = document.getElementById('pub-confirm-btn');
        if (confirmBtn) {
            confirmBtn.disabled = false;
            confirmBtn.style.cursor = 'pointer';
            confirmBtn.style.opacity = '1';
            confirmBtn.addEventListener('click', async () => {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Publishing…';
                try {
                    await saveDraftToServer();
                    const pubRes = await fetch(`/${SOP_LOB}/sop/publish`, { method: 'POST', credentials: 'same-origin' });
                    const pubData = await pubRes.json();
                    if (pubData.success) {
                        backdrop.remove();
                        showToast(`SOP published as v${pubData.version}! 🎉`, 'success');
                        setTimeout(() => location.reload(), 1500);
                    } else throw new Error(pubData.error || 'Publish failed');
                } catch (e) {
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = '🚀 Confirm Publish';
                    showToast('Error: ' + e.message, 'warning');
                }
            });
        }
    }
}

// Initialization and DOM wireup
function initEditMode() {
    renderSopLayout();
    renderSidebar();

    document.getElementById('sop-undo-btn')?.addEventListener('click', undo);
    document.getElementById('sop-redo-btn')?.addEventListener('click', redo);
    document.getElementById('sop-options-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const drop = document.getElementById('sop-options-dropdown');
        if (drop) drop.style.display = drop.style.display === 'none' ? 'block' : 'none';
    });

    document.getElementById('sop-save-layout-btn')?.addEventListener('click', async () => {
        const btn = document.getElementById('sop-save-layout-btn');
        const oldText = btn.innerHTML;
        btn.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Saving...';
        await saveDraftToServer();
        btn.innerHTML = oldText;
        showToast('Draft saved successfully', 'success');
    });

    document.getElementById('sop-publish-btn')?.addEventListener('click', openPublishValidationModal);

    document.addEventListener('click', () => {
        const drop = document.getElementById('sop-options-dropdown');
        if (drop) drop.style.display = 'none';
    });

    // Wire up Enter key for AI Chat input
    const aiInput = document.getElementById('aiInput');
    if (aiInput) {
        aiInput.addEventListener('keydown', e => {
            if (e.key === 'Enter' && !e.shiftKey) {
                e.preventDefault();
                sendAiChatMessage();
            }
        });
    }

    // Set page data mode
    document.body.setAttribute('data-mode', 'edit');
    const style = document.createElement('style');
    style.textContent = `
        .sop-drag-ghost { opacity:.4; transform:rotate(1.5deg); }
        body[data-mode="edit"] .sop-card { cursor:grab; }
        body[data-mode="edit"] .sop-card:active { cursor:grabbing; }
    `;
    document.head.appendChild(style);
}

// Run boot operations
document.addEventListener('DOMContentLoaded', () => {
    if (SOP_MODE === 'edit') {
        (function loadSortable(cb) {
            if (window.Sortable) { cb(); return; }
            const s = document.createElement('script');
            s.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js';
            s.onload = cb;
            document.head.appendChild(s);
        })(initEditMode);
    } else if (SOP_MODE === 'preview') {
        // Readonly dynamic render of draft state for preview mode
        renderSopLayout();
        renderSidebar();
    }
});

</script>

<% if (typeof mode !== 'undefined' && mode === 'edit') { %>
<!-- AI Drawer Sidebar -->
<div class="ai-sidebar" id="aiSidebar">
    <div class="ai-header">
        <div class="ai-title">✨ Zomato SOP AI Chatbot</div>
        <button class="ai-close" onclick="toggleAiSidebar()">✕</button>
    </div>
    <div class="ai-chat-messages" id="aiChatMessages">
        <div class="ai-msg bot">
            Hi Aditya! I am your WIMO SOP assistant. You can ask me to draft a calling script, refine compensation guidelines, or suggest detailed actions for a particular case.
        </div>
    </div>
    <div class="ai-input-container">
        <textarea class="ai-input" id="aiInput" placeholder="Ask AI... (Press Shift+Enter to send)"></textarea>
        <button class="ai-send-btn" id="aiSendBtn" onclick="sendAiChatMessage()">Send</button>
    </div>
</div>
<div class="ai-sidebar-toggle" id="aiSidebarToggle" onclick="toggleAiSidebar()" title="Ask WIMO AI Assistant">
    <i class="fa fa-android"></i>
</div>
<% } %>

</body>
</html>

        <div class="pb-divider"></div>

        <!-- G-Sheet Source Button -->
        <button class="pb-sheet-btn" id="pbSheetBtn" onclick="openSheetModal()" title="View source Google Sheet">
            <!-- Google Sheets SVG icon -->
            <svg class="pb-sheet-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <rect x="3" y="1" width="18" height="22" rx="2" fill="#34a853"/>
                <rect x="3" y="1" width="18" height="22" rx="2" fill="url(#sheetGrad)"/>
                <path d="M14 1v5h5" fill="none" stroke="#fff" stroke-width="1.2" opacity="0.6"/>
                <path d="M14 1l5 5H14V1z" fill="#1e8c45"/>
                <rect x="6" y="9"  width="12" height="1.2" rx="0.6" fill="#fff" opacity="0.9"/>
                <rect x="6" y="12" width="12" height="1.2" rx="0.6" fill="#fff" opacity="0.9"/>
                <rect x="6" y="15" width="8"  height="1.2" rx="0.6" fill="#fff" opacity="0.9"/>
                <rect x="10.5" y="9" width="1" height="9" rx="0.5" fill="#fff" opacity="0.4"/>
                <defs>
                    <linearGradient id="sheetGrad" x1="3" y1="1" x2="21" y2="23" gradientUnits="userSpaceOnUse">
                        <stop offset="0%" stop-color="#34a853"/>
                        <stop offset="100%" stop-color="#1e8c45"/>

<script>
    /* ─ COMP CALCULATOR ──────────────────────────────────────────── */
    function runCalc() {
        const delay = parseInt(document.getElementById('calcDelay').value);
        const ov    = parseFloat(document.getElementById('calcOV').value);
        let comp = 0;
        if (!delay || !ov) { document.getElementById('finalComp').innerText = "₹0"; return; }
        if (delay > 30 && delay <= 45) {
            comp = ov < 50 ? ov : Math.max(50, Math.min(100, ov * 0.35));
        } else if (delay > 45) {
            comp = Math.min(500, ov);
        }
        document.getElementById('finalComp').innerText = "₹" + Math.round(comp);
    }

    /* ─ SEARCH ───────────────────────────────────────────────────── */
    function filterSOP() {
        const q = document.getElementById('sopSearch').value.toLowerCase();
        document.querySelectorAll('.sop-card').forEach(c => {
            const tags  = (c.dataset.tags || '').toLowerCase();
            const title = c.innerText.toLowerCase();
            c.style.display = (tags.includes(q) || title.includes(q)) ? '' : 'none';
        });
    }

    /* ─ COPY SCRIPT ──────────────────────────────────────────────── */
    function copyScript() {
        const t = "Hi, Good Morning Sir, My name is XYZ from Zomato. May I know the reason for the delay and by when the order will be delivered?";
        navigator.clipboard.writeText(t).then(() => showToast("Script copied!", "success"));
    }

    /* ─ SOP DETAIL MODAL ─────────────────────────────────────────── */
    function openModal(card) {
        const title      = card.querySelector('.card-header').innerText;
        const cond       = card.querySelector('.card-cond').innerText;
        const actionTag  = card.querySelector('.action-tag');
        const detailText = card.querySelector('.card-detail-data').innerText;
        const tagClass   = actionTag.className.replace('action-tag ', '');

        document.getElementById('modalTitle').innerText = title;
        document.getElementById('modalCond').innerText  = cond;

        const tagEl      = document.getElementById('modalTag');
        tagEl.innerText  = actionTag.innerText;
        tagEl.className  = 'modal-tag action-tag ' + tagClass;

        document.getElementById('modalBody').innerHTML = detailText
            .split('\n').map(line => {
                line = line.trim();
                if (!line) return '<br>';
                if (line.startsWith('•')) return '<span style="display:block;margin:4px 0;">• ' + line.slice(1).trim() + '</span>';
                if (/^(Case|Note|⚠️|Special|Example|Prompt|Important|Minor|Major)/i.test(line))
                    return '<strong style="display:block;margin-top:10px;">' + line + '</strong>';
                return '<span style="display:block;">' + line + '</span>';
            }).join('');

        document.getElementById('modalOverlay').classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeModal() {
        document.getElementById('modalOverlay').classList.remove('open');
        document.body.style.overflow = '';
    }

    function closeModalOutside(e) {
        if (e.target === document.getElementById('modalOverlay')) closeModal();
    }

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
            closeModal();
            closeViewersPanel();
        }
    });

    /* ─ TOAST ────────────────────────────────────────────────────── */
    function showToast(msg, type) {
        const t = document.getElementById('toast');
        t.textContent = msg;
        t.className = 'toast' + (type ? ' ' + type : '');
        void t.offsetWidth;
        t.classList.add('show');
        setTimeout(() => t.classList.remove('show'), 2800);
    }

    /* ═══ G-SHEET SOURCE LINK ════════════════════════════════════════
       Stores the linked sheet URL in localStorage so it persists.
       Validates it's a real Google Sheets URL before saving.
    ═══════════════════════════════════════════════════════════════ */
    const SHEET_KEY = 'wimo_source_sheet_url';

    // Roles that can link/edit the sheet URL
    // Match exactly what SupportHub stores in user.role
    // Add/remove values here to match your actual role strings
    const SHEET_EDITOR_ROLES = [
        // Display labels (used when WIMO name popup is shown manually)
        'Admin', 'QA Analyst', 'Team Leader', 'Vendor',
        // Raw SupportHub role slugs (used when session is auto-filled)
        'admin', 'quality_analyst', 'qa_analyst', 'team_leader', 'teamlead', 'vendor'
    ];

    // Boot: restore saved URL on page load, enforce role permissions
    (function initSheetButton() {
        const saved = localStorage.getItem(SHEET_KEY);
        if (saved) applySheetUrl(saved, false);
        // Role check runs after myProfile is set (inside presence boot),
        // but we also enforce it here for immediate DOM state on reload.
        // The definitive enforcement is in openSheetModal() and applySheetUrl().
    })();

    function canEditSheet() {
        // myProfile.role is set after name modal; fallback checks button class
        if (typeof myProfile !== 'undefined' && myProfile && myProfile.role) {
            return SHEET_EDITOR_ROLES.includes(myProfile.role);
        }
        // Fallback: check if button has agent-readonly class (set by applySheetUrl)
        const btn = document.getElementById('pbSheetBtn');
        return btn && !btn.classList.contains('agent-readonly');
    }

    function openSheetModal() {
        // Block Agents from linking/editing
        if (!canEditSheet()) {
            const linked = !!localStorage.getItem(SHEET_KEY);
            if (linked) {
                // Agent can only open — send them directly to the sheet
                const url = localStorage.getItem(SHEET_KEY);
                window.open(url, '_blank');
            } else {
                showToast('Agents cannot link the source sheet.', 'warning');
            }
            return;
        }
        const saved = localStorage.getItem(SHEET_KEY) || '';
        const input = document.getElementById('smUrlInput');
        input.value = saved;
        onSheetUrlInput(saved);
        document.getElementById('sheetModalBackdrop').classList.add('open');
        setTimeout(() => input.focus(), 120);
    }

    function closeSheetModal() {
        document.getElementById('sheetModalBackdrop').classList.remove('open');
    }

    function closeSheetModalOutside(e) {
        if (e.target === document.getElementById('sheetModalBackdrop')) closeSheetModal();
    }

    function onSheetUrlInput(val) {
        val = val.trim();
        const valid    = isValidSheetUrl(val);
        const hasVal   = val.length > 0;
        const saveBtn  = document.getElementById('smSaveBtn');
        const preview  = document.getElementById('smPreview');
        const prevText = document.getElementById('smPreviewText');
        const clearBtn = document.getElementById('smClear');
        const openBtn  = document.getElementById('smOpenBtn');

        saveBtn.disabled = !valid;

        if (valid) {
            const name = extractSheetName(val);
            prevText.textContent = name ? '"' + name + '" — valid Google Sheets URL ✓' : 'Valid Google Sheets URL ✓';
            preview.classList.add('show');
            openBtn.href = val;
            openBtn.style.display = 'flex';
        } else {
            preview.classList.remove('show');
            openBtn.style.display = 'none';
        }

        clearBtn.classList.toggle('show', hasVal && !!localStorage.getItem(SHEET_KEY));
    }

    function saveSheetUrl() {
        const val = document.getElementById('smUrlInput').value.trim();
        if (!isValidSheetUrl(val)) return;
        localStorage.setItem(SHEET_KEY, val);
        applySheetUrl(val, true);
        closeSheetModal();
        showToast('Source sheet linked! 🔗', 'success');
    }

    function clearSheetUrl() {
        if (!confirm('Remove the linked source sheet?')) return;
        localStorage.removeItem(SHEET_KEY);
        document.getElementById('smUrlInput').value = '';
        onSheetUrlInput('');
        applySheetUrl(null, false);
        closeSheetModal();
        showToast('Source sheet removed');
    }

    function applySheetUrl(url, animate) {
        const btn   = document.getElementById('pbSheetBtn');
        const dot   = document.getElementById('pbSheetDot');
        const label = document.getElementById('pbSheetLabel');
        const isEditor = canEditSheet();

        if (!isEditor) {
            btn.classList.add('agent-readonly');
            btn.title = url
                ? 'Open source Google Sheet (view only)'
                : 'Source sheet — linking restricted to QA Analyst, Team Leader, Vendor, Admin';
        } else {
            btn.classList.remove('agent-readonly');
        }

        if (url) {
            btn.onclick = null;
            btn.setAttribute('data-linked', 'true');
            btn.classList.add('linked');
            btn.addEventListener('click', handleSheetBtnClick, { once: false });
            dot.classList.add('show');
            label.textContent = 'Source Sheet';
            if (!isEditor) {
                btn.title = 'Open source Google Sheet (view only)';
            } else {
                btn.title = 'Open source Google Sheet (right-click to change URL)';
            }
            if (animate) {
                btn.style.transform = 'scale(1.08)';
                setTimeout(() => btn.style.transform = '', 300);
            }
        } else {
            btn.onclick = openSheetModal;
            btn.removeEventListener('click', handleSheetBtnClick);
            btn.setAttribute('data-linked', 'false');
            btn.classList.remove('linked');
            dot.classList.remove('show');
            label.textContent = 'Source Sheet';
        }
    }

    function handleSheetBtnClick(e) {
        const url = localStorage.getItem(SHEET_KEY);
        if (!url) { openSheetModal(); return; }
        if (e.ctrlKey || e.metaKey || e.shiftKey) {
            e.preventDefault();
            openSheetModal();
        } else {
            window.open(url, '_blank');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const btn = document.getElementById('pbSheetBtn');
        btn.addEventListener('contextmenu', function(e) {
            if (localStorage.getItem(SHEET_KEY)) {
                e.preventDefault();
                openSheetModal();
            }
        });
    });

    function isValidSheetUrl(url) {
        if (!url) return false;
        try {
            const u = new URL(url);
            return u.hostname === 'docs.google.com' && u.pathname.includes('/spreadsheets/');
        } catch(_) {
            return false;
        }
    }

    function extractSheetName(url) {
        try {
            const u = new URL(url);
            const title = u.searchParams.get('title') || u.searchParams.get('rm');
            if (title) return decodeURIComponent(title);
        } catch(_) {}
        return null;
    }
</script>

<script type="module">
const HEARTBEAT_MS   = 18000;
const STALE_THRESHOLD = 40000;

const PALETTE = [
    "#CB202D","#1565C0","#2E7D32","#6A1B9A",
    "#C62828","#00695C","#E65100","#283593",
    "#4E342E","#37474F"
];

const ROLE_COLOR = {
    "Agent":       "#37474F",
    "QA Analyst":  "#1565C0",
    "Team Leader": "#2E7D32",
    "Vendor":      "#6A1B9A",
    "Admin":       "#CB202D",
    "Editor":      "#e65100"
};

function mapRole(role) {
    if (!role) return 'Agent';
    const map = {
        'admin': 'Admin',
        'quality_analyst': 'QA Analyst',
        'qa_analyst': 'QA Analyst',
        'team_lead': 'Team Leader',
        'teamlead': 'Team Leader',
        'vendor': 'Vendor',
        'user': 'Agent',
        'editor': 'Editor'
    };
    return map[role.toLowerCase()] || role;
}

let myProfile    = null;
let firebaseMode = false;
let fbRefs       = null;
let localMap     = {};
let panelOpen    = false;

(async function boot() {
    let config = null;
    try {
        const res = await fetch('/api/user-activity/firebase-config');
        if (res.ok) {
            const data = await res.json();
            config = data.config;
        }
    } catch(err) {
        console.warn("[WIMO] Failed to fetch Firebase config from API:", err);
    }

    if (config && config.databaseURL) {
        try {
            const { initializeApp } = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js");
            const { getDatabase, ref, set, onValue, remove, onDisconnect }
                = await import("https://www.gstatic.com/firebasejs/10.12.0/firebase-database.js");
            const app = initializeApp(config);
            const db  = getDatabase(app);
            fbRefs = { db, ref, set, onValue, remove, onDisconnect };
            firebaseMode = true;
            setLiveStatus("online");
        } catch(err) {
            console.warn("[WIMO] Firebase init failed:", err.message);
            setLiveStatus("offline");
        }
    } else {
        setLiveStatus("pending");
        const setupEl = document.getElementById("vpFirebaseSetup");
        if (setupEl) setupEl.classList.add("show");
    }

    if (window.__sopUsername) {
        myProfile = buildProfile({
            name: window.__sopUsername,
            role: window.__sopUserRole,
            id: window.__sopUserId,
            _fromServer: true
        });
        localStorage.setItem("wimo_viewer_v2", JSON.stringify(myProfile));
        closeNameModal();
        startPresence();
        applySheetUrl(localStorage.getItem(SHEET_KEY) || null, false);
        console.info("[WIMO] Auto-auth from EJS session:", myProfile.name, "/", myProfile.role);
        return;
    }

    try {
        const r = await fetch("/api/wimo/me", {
            credentials: "include",
            headers: { "Accept": "application/json" }
        });
        if (r.ok) {
            const d = await r.json();
            if (d.authenticated && d.name) {
                myProfile = buildProfile(d);
                localStorage.setItem("wimo_viewer_v2", JSON.stringify(myProfile));
                closeNameModal();
                startPresence();
                applySheetUrl(localStorage.getItem(SHEET_KEY) || null, false);
                return;
            }
        }
    } catch(_) {}

    const saved = localStorage.getItem("wimo_viewer_v2");
    if (saved) {
        try {
            const parsed = JSON.parse(saved);
            if (parsed._fromServer) {
                localStorage.removeItem("wimo_viewer_v2");
            } else {
                myProfile = parsed;
                myProfile.joinedAt = Date.now();
                closeNameModal();
                startPresence();
                applySheetUrl(localStorage.getItem(SHEET_KEY) || null, false);
                return;
            }
        } catch(_) {}
    }

    openNameModal();
})();

function buildProfile(src) {
    const name = src.name     || src.username || "<%= user && user.username ? user.username : 'Guest' %>";
    const role = mapRole(src.role || "<%= user && user.role ? user.role : 'user' %>");
    const color    = src.color    || nameToColor(name);
    const initials = src.initials || getInitials(name);
    return {
        id:          src.id || src._id || genId(),
        name, role, color, initials,
        joinedAt:    Date.now(),
        _fromServer: !!(src._fromServer || src.fromServer)
    };
}

window.nmSelectRole = function(btn, role) {
    document.querySelectorAll(".nm-role-pill").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    nmSelectedRole = role;
};

window.nmOnInput = function() {
    const val = document.getElementById("nmNameInput").value.trim();
    document.getElementById("nmSubmitBtn").disabled = val.length < 2;
    const av = document.getElementById("nmAvatar");
    if (val.length >= 1) {
        av.textContent = getInitials(val);
        av.style.background = nameToColor(val);
        av.style.borderColor = nameToColor(val) + "33";
        av.classList.add("has-name");
    } else {
        av.textContent = "?";
        av.style.background = "#e0e0e0";
        av.style.borderColor = "#f0f0f0";
        av.classList.remove("has-name");
    }
};

window.nmSubmit = function() {
    const name = document.getElementById("nmNameInput").value.trim();
    if (name.length < 2) return;
    myProfile = {
        id:       genId(),
        name,
        role:     nmSelectedRole,
        color:    nameToColor(name),
        initials: getInitials(name),
        joinedAt: Date.now()
    };
    localStorage.setItem("wimo_viewer_v2", JSON.stringify(myProfile));
    closeNameModal();
    startPresence();
    applySheetUrl(localStorage.getItem(SHEET_KEY) || null, false);
    showToast("Welcome, " + name + "! 👋", "success");
};

function openNameModal()  { document.getElementById("nameModalBackdrop").classList.add("open"); }
function closeNameModal() { document.getElementById("nameModalBackdrop").classList.remove("open"); }

function startPresence() {
    updateYouChip(myProfile);
    if (firebaseMode && fbRefs) {
        startFirebase();
    } else {
        startDemoMode();
    }
}

function startFirebase() {
    const { db, ref, set, onValue, remove, onDisconnect } = fbRefs;
    const department = (window.__sopLob || 'zomato').toLowerCase().trim();
    const myRef  = ref(db, `presence/${department}/${myProfile.name}`);
    const allRef = ref(db, `presence/${department}`);

    let currentStatus = 'online';
    let lastActivityTime = Date.now();
    const IDLE_TIME_LIMIT = 3 * 60 * 1000;

    const payload = () => ({
        username:  myProfile.name,
        role:      window.__sopUserRole || myProfile.role || 'user',
        dept:      department,
        status:    currentStatus,
        ts:        Date.now()
    });

    const updateFirebaseStatus = (newStatus) => {
        if (currentStatus === newStatus) return;
        currentStatus = newStatus;
        set(myRef, payload());
    };

    const resetIdleTimer = () => {
        lastActivityTime = Date.now();
        if (currentStatus === 'idle') {
            updateFirebaseStatus('online');
        }
    };

    const activityEvents = ['mousemove', 'mousedown', 'keydown', 'scroll', 'touchstart'];
    activityEvents.forEach(ev => {
        document.addEventListener(ev, resetIdleTimer, { passive: true });
    });

    set(myRef, payload());
    onDisconnect(myRef).remove();

    const hb = setInterval(() => {
        const idleDuration = Date.now() - lastActivityTime;
        if (idleDuration >= IDLE_TIME_LIMIT) {
            currentStatus = 'idle';
        } else {
            currentStatus = 'online';
        }
        set(myRef, payload());
    }, HEARTBEAT_MS);

    onValue(allRef, snap => {
        const raw = snap.val() || {};
        const now = Date.now();
        const viewers = Object.entries(raw)
            .filter(([, v]) => v && v.username && (firebaseMode || (now - (v.ts || v.lastSeen || 0)) < STALE_THRESHOLD))
            .map(([key, v]) => {
                const uName = v.username || key;
                return {
                    id:       uName,
                    name:     uName,
                    role:     mapRole(v.role),
                    color:    v.color || nameToColor(uName),
                    initials: v.initials || getInitials(uName),
                    joinedAt: v.ts || v.lastSeen || now,
                    lastSeen: v.ts || v.lastSeen || now,
                    status:   v.status || 'online'
                };
            });
        renderAll(viewers);
    });

    window.addEventListener("beforeunload", () => {
        remove(myRef);
        clearInterval(hb);
    });
}

function startDemoMode() {
    localMap = {};
    localMap[myProfile.id] = { ...myProfile, lastSeen: Date.now(), status: 'online' };
    renderAll(Object.values(localMap));

    setInterval(() => {
        localMap[myProfile.id].lastSeen = Date.now();
        renderAll(Object.values(localMap));
    }, HEARTBEAT_MS);
}

function renderAll(viewers) {
    viewers.sort((a, b) => {
        if (a.id === myProfile.name || a.id === myProfile.id) return -1;
        if (b.id === myProfile.name || b.id === myProfile.id) return  1;
        return (a.joinedAt || 0) - (b.joinedAt || 0);
    });

    renderAvatarStrip(viewers);
    renderCountLabel(viewers.length);
    renderViewersPanel(viewers);
}

function renderAvatarStrip(viewers) {
    const container = document.getElementById("pbAvatars");
    const MAX = 7;
    const shown    = viewers.slice(0, MAX);
    const overflow = viewers.length - MAX;

    container.innerHTML = shown.map((v, i) => {
        const isMe = v.id === myProfile.name || v.id === myProfile.id;
        const statusText = v.status === 'idle' ? 'Idle' : 'Active';
        return `<div class="pb-avatar ${isMe ? "is-you" : ""}"
                     style="background:${v.color||"#999"}; z-index:${50-i}"
                     tabindex="0">
                    ${v.initials || "?"}
                    <div class="pb-avatar-tip">
                        ${esc(v.name)}${isMe ? " <span style=\"color:#ff9090\">(You)</span>" : ""}<br>
                        <span style="opacity:.75;font-size:.6rem">${v.role || "Viewer"} (${statusText})</span>
                    </div>
                </div>`;
    }).join("");

    if (overflow > 0) {
        container.innerHTML += `<div class="pb-overflow" title="${overflow} more people viewing" onclick="toggleViewersPanel()">+${overflow}</div>`;
    }
}

function renderCountLabel(count) {
    const el = document.getElementById("pbCountLabel");
    if (count === 0) {
        el.innerHTML = "";
    } else if (count === 1) {
        el.innerHTML = `<span style="color:#24963F;font-weight:800;">Only you</span>`;
    } else {
        el.innerHTML = `<span style="font-weight:800;color:#2D2D2D">${count} viewing now</span>`;
    }
    document.getElementById("vpCountChip").textContent = count;
}

function renderViewersPanel(viewers) {
    const list = document.getElementById("vpList");
    list.innerHTML = viewers.map(v => {
        const isMe  = v.id === myProfile.name || v.id === myProfile.id;
        const rc    = ROLE_COLOR[v.role] || "#555";
        const since = timeSince(v.joinedAt);
        const statusLabel = v.status === 'on_break' ? 'On Break' : (v.status === 'idle' ? 'Idle' : 'Online');
        const statusColor = v.status === 'on_break' ? '#ffc107' : (v.status === 'idle' ? '#dc3545' : '#24963F');
        const pulseAnim = v.status === 'idle' ? 'none' : 'liveGlow 2s infinite';
        
        return `<div class="vp-item">
            <div class="vp-avatar" style="background:${v.color||"#999"}">${v.initials||"?"}</div>
            <div class="vp-info">
                <div class="vp-name">${esc(v.name)}</div>
                <div class="vp-role" style="color:${rc}">${v.role||"Viewer"}</div>
            </div>
            <div class="vp-active-dot" title="${statusLabel}" style="background-color: ${statusColor}; animation: ${pulseAnim};"></div>
            ${isMe
                ? `<span class="vp-badge-you">You</span>`
                : `<span class="vp-joined-time">${since}</span>`}
        </div>`;
    }).join("") || `<div style="padding:16px;text-align:center;font-size:.8rem;color:#bbb;">No viewers yet</div>`;
}

// ─── YOUR CHIP ────────────────────────────────────────────────────────
function updateYouChip(p) {
    const chip  = document.getElementById("pbYouChip");
    const av    = document.getElementById("pbYouAvatar");
    const name  = document.getElementById("pbYouName");
    const role  = document.getElementById("pbYouRole");

    av.textContent    = p.initials || "?";
    av.style.background = p.color || "#999";
    name.textContent  = p.name;
    role.textContent  = p.role || "Viewer";
    chip.classList.add("visible");
}

// ─── LIVE STATUS DOT ─────────────────────────────────────────────────
function setLiveStatus(state) {
    const dot  = document.getElementById("pbLiveDot");
    const text = document.getElementById("pbLiveText");
    const map  = {
        online:  { dotCls: "online",  color: "#24963F", label: "Live"         },
        pending: { dotCls: "pending", color: "#F5A623", label: "Demo mode"    },
        offline: { dotCls: "offline", color: "#ccc",    label: "Disconnected" }
    };
    const s = map[state] || map.pending;
    dot.className  = "pb-live-dot " + s.dotCls;
    text.textContent = s.label;
    text.style.color = s.color;
    text.className = "pb-live-text " + s.dotCls;
}

// ─── PANEL TOGGLE ─────────────────────────────────────────────────────
window.toggleViewersPanel = function() {
    panelOpen = !panelOpen;
    document.getElementById("viewersPanel").classList.toggle("open", panelOpen);
};

function closeViewersPanel() {
    panelOpen = false;
    document.getElementById("viewersPanel").classList.remove("open");
}

document.addEventListener("click", e => {
    if (!e.target.closest("#viewersPanel") &&
        !e.target.closest("[onclick='toggleViewersPanel()']") &&
        !e.target.closest(".pb-see-all") &&
        !e.target.closest(".pb-you-chip") &&
        !e.target.closest(".pb-overflow")) {
        closeViewersPanel();
    }
});

// ─── UTILITIES ────────────────────────────────────────────────────────
function getInitials(name) {
    if (!name?.trim()) return "?";
    const p = name.trim().split(/\s+/);
    return p.length === 1
        ? p[0].substring(0, 2).toUpperCase()
        : (p[0][0] + p[p.length - 1][0]).toUpperCase();
}

function nameToColor(name) {
    if (!name) return PALETTE[0];
    let h = 0;
    for (let i = 0; i < name.length; i++) h = name.charCodeAt(i) + ((h << 5) - h);
    return PALETTE[Math.abs(h) % PALETTE.length];
}

function genId() {
    return "u_" + Math.random().toString(36).slice(2, 9) + "_" + Date.now().toString(36);
}

function timeSince(ts) {
    if (!ts) return "";
    const s = Math.floor((Date.now() - ts) / 1000);
    if (s < 10)   return "just now";
    if (s < 60)   return s + "s ago";
    if (s < 3600) return Math.floor(s / 60) + "m ago";
    return Math.floor(s / 3600) + "h ago";
}

function esc(str) {
    return String(str || "")
        .replace(/&/g,"&amp;").replace(/</g,"&lt;")
        .replace(/>/g,"&gt;").replace(/"/g,"&quot;");
}

// ─────────────────────────────────────────────────────────────────────
// SOP EDITOR — only active when server renders mode='edit'
// The view route (/zomato/sop/view) passes mode:'view' → no edit UI.
// The edit route (/zomato/sop/edit) passes mode:'edit' → full editor.
// ─────────────────────────────────────────────────────────────────────
const SOP_MODE = '<%= typeof mode !== "undefined" ? mode : "view" %>';
const SOP_LOB  = window.__sopLob || 'zomato';

if (SOP_MODE === 'edit') {
    // Load SortableJS for drag-to-reorder (CDN, async)
    (function loadSortable(cb) {
        if (window.Sortable) { cb(); return; }
        const s = document.createElement('script');
        s.src = 'https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js';
        s.onload = cb;
        document.head.appendChild(s);
    })(initEditMode);
} else {
    // VIEW MODE — nothing to do; all edit controls are EJS-gated
}

function initEditMode() {
    showEditToolbar();
    enableDragSort();
    injectBlockEditButtons();
}

/* ─── Edit Toolbar ──────────────────────────────────────── */
function showEditToolbar() {
    const toolbar = document.createElement('div');
    toolbar.id = 'sop-edit-toolbar';
    toolbar.style.cssText = `
        position: sticky; top: 0; z-index: 200;
        background: #1e293b; color: #f1f5f9;
        display: flex; align-items: center; gap: 12px;
        padding: 10px 20px; font-size: 13px;
        box-shadow: 0 2px 8px rgba(0,0,0,.25);
    `;
    toolbar.innerHTML = `
        <span style="font-weight:800;letter-spacing:.5px;">✏️ EDIT MODE</span>
        <span style="opacity:.5;font-size:11px;">Drag cards to reorder · Click ✏️ to edit a block</span>
        <div style="margin-left:auto;display:flex;gap:8px;">
            <button id="sop-add-cat-btn" style="padding:7px 16px;background:#7c3aed;color:#fff;border:none;border-radius:7px;font-weight:700;cursor:pointer;font-family:inherit;">+ Add Category</button>
            <button id="sop-save-layout-btn" style="padding:7px 16px;background:#16a34a;color:#fff;border:none;border-radius:7px;font-weight:700;cursor:pointer;font-family:inherit;">💾 Save Layout</button>
            <a href="/${SOP_LOB}/sop/view" style="padding:7px 14px;background:#475569;color:#fff;border-radius:7px;font-weight:700;text-decoration:none;font-size:13px;display:flex;align-items:center;">👁 View Mode</a>
        </div>
    `;
    document.body.insertBefore(toolbar, document.body.firstChild);

    document.getElementById('sop-add-cat-btn').addEventListener('click', () => openCategoryModal());
    document.getElementById('sop-save-layout-btn').addEventListener('click', saveLayout);
}

/* ─── Drag to Reorder ───────────────────────────────────── */
function enableDragSort() {
    // Make each category section's card list sortable
    document.querySelectorAll('.sop-grid').forEach(grid => {
        if (window.Sortable) {
            new Sortable(grid, {
                animation: 150,
                handle: '.sop-card',
                ghostClass: 'sop-drag-ghost',
                onEnd() { highlightSaveBtn(); }
            });
        }
    });
}

function highlightSaveBtn() {
    const btn = document.getElementById('sop-save-layout-btn');
    if (btn) { btn.style.background = '#dc2626'; btn.textContent = '💾 Save Changes!'; }
}

async function saveLayout() {
    const order = [];
    document.querySelectorAll('.sop-card[data-sop-id]').forEach(card => {
        const section = card.closest('[data-category]');
        const category = section?.dataset.category || 'General';
        order.push({ id: card.dataset.sopId, category });
    });

    if (!order.length) { showToast('Nothing to save', 'warning'); return; }

    try {
        const res = await fetch(`/${SOP_LOB}/sop/reorder`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ order }),
            credentials: 'same-origin'
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');
        showToast('Layout saved ✓', 'success');
        const btn = document.getElementById('sop-save-layout-btn');
        if (btn) { btn.style.background = '#16a34a'; btn.textContent = '💾 Save Layout'; }
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}

/* ─── Block Edit Buttons ────────────────────────────────── */
function injectBlockEditButtons() {
    document.querySelectorAll('.sop-card').forEach(card => {
        if (card.querySelector('.sop-edit-btn')) return;

        const wrap = document.createElement('div');
        wrap.style.cssText = 'position:absolute;top:6px;right:6px;display:flex;gap:4px;z-index:10;';

        const editBtn = document.createElement('button');
        editBtn.className = 'sop-edit-btn';
        editBtn.title = 'Edit this SOP block';
        editBtn.innerHTML = '✏️';
        editBtn.style.cssText = 'background:rgba(37,99,235,.1);border:1px solid #2563eb;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:12px;';
        editBtn.addEventListener('click', e => { e.stopPropagation(); openBlockEditModal(card); });

        const delBtn = document.createElement('button');
        delBtn.className = 'sop-del-btn';
        delBtn.title = 'Delete this SOP block';
        delBtn.innerHTML = '🗑';
        delBtn.style.cssText = 'background:rgba(220,38,38,.1);border:1px solid #dc2626;border-radius:5px;padding:2px 7px;cursor:pointer;font-size:12px;';
        delBtn.addEventListener('click', e => { e.stopPropagation(); deleteBlock(card); });

        // Add Block button at category level
        card.style.position = 'relative';
        wrap.appendChild(editBtn);
        wrap.appendChild(delBtn);
        card.appendChild(wrap);
    });

    // Add "+ New Block" buttons after each category grid
    document.querySelectorAll('[data-category]').forEach(section => {
        if (section.querySelector('.sop-add-block-btn')) return;
        const btn = document.createElement('button');
        btn.className = 'sop-add-block-btn';
        btn.textContent = '＋ Add Block';
        btn.style.cssText = `
            display:block;width:100%;margin:8px 0 16px;
            padding:8px;background:#f0f7ff;border:1.5px dashed #2563eb;
            border-radius:8px;color:#2563eb;font-weight:700;cursor:pointer;
            font-size:13px;transition:background .15s;
        `;
        btn.addEventListener('click', () => openBlockCreateModal(section.dataset.category));
        section.appendChild(btn);
    });
}

/* ─── Category Modal ────────────────────────────────────── */
function openCategoryModal() {
    const backdrop = buildBackdrop('sopCatBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:420px;max-width:97%;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative;">
            <button onclick="document.getElementById('sopCatBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1rem;color:#7c3aed;">＋ New SOP Category</h3>
            <label style="font-size:.78rem;font-weight:700;color:#64748b;display:block;margin-bottom:5px;">CATEGORY NAME</label>
            <input id="newCatName" type="text" placeholder="e.g. 03. POST-DELIVERY"
                style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:16px;">
            <button id="saveCatBtn" style="width:100%;padding:11px;background:#7c3aed;color:#fff;border:none;border-radius:8px;font-weight:800;font-family:inherit;cursor:pointer;font-size:.9rem;">Create Category</button>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    document.getElementById('saveCatBtn').addEventListener('click', async () => {
        const name = document.getElementById('newCatName').value.trim();
        if (!name) { showToast('Name required', 'warning'); return; }
        try {
            const res = await fetch(`/${SOP_LOB}/sop/category`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name }),
                credentials: 'same-origin'
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Failed');
            showToast('Category created — reloading…', 'success');
            setTimeout(() => location.reload(), 900);
        } catch (err) { showToast('Error: ' + err.message, 'warning'); }
    });
}

/* ─── Block Create Modal ────────────────────────────────── */
function openBlockCreateModal(category) {
    const backdrop = buildBackdrop('sopBlockBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:560px;max-width:97%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative;">
            <button onclick="document.getElementById('sopBlockBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1rem;color:#2563eb;">＋ New Block in "${esc(category)}"</h3>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TITLE</label>
            <input id="nb-title" type="text" placeholder="Scenario title" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">CONDITION / TRIGGER</label>
            <input id="nb-cond" type="text" placeholder="When does this apply?" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">ACTION</label>
            <select id="nb-action" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px;font-family:inherit;font-size:.88rem;margin-bottom:12px;">
                <option value="Wait">Wait</option>
                <option value="Cancel">Cancel</option>
                <option value="Escalate">Escalate</option>
            </select>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TAGS (comma-separated)</label>
            <input id="nb-tags" type="text" placeholder="e.g. delay, restaurant, mx" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:8px 11px;font-family:inherit;font-size:.88rem;margin-bottom:16px;">
            <button id="saveBlockBtn" style="width:100%;padding:11px;background:#2563eb;color:#fff;border:none;border-radius:8px;font-weight:800;font-family:inherit;cursor:pointer;font-size:.9rem;">Create Block</button>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    document.getElementById('saveBlockBtn').addEventListener('click', async () => {
        const title     = document.getElementById('nb-title').value.trim();
        const condition = document.getElementById('nb-cond').value.trim();
        const action    = document.getElementById('nb-action').value;
        const tags      = document.getElementById('nb-tags').value;
        if (!title) { showToast('Title required', 'warning'); return; }
        try {
            const res = await fetch(`/${SOP_LOB}/sop/block`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ category, title, condition, action, tags, status: 'Draft' }),
                credentials: 'same-origin'
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Failed');
            showToast('Block created — reloading…', 'success');
            setTimeout(() => location.reload(), 900);
        } catch (err) { showToast('Error: ' + err.message, 'warning'); }
    });
}

/* ─── Block Edit Modal ──────────────────────────────────── */
function openBlockEditModal(card) {
    const sopId   = card.dataset.sopId || '';
    if (!sopId) { showToast('No SOP ID on this card (static card — use SOP Builder)', 'warning'); return; }
    const title   = card.querySelector('.card-header')?.innerText  || '';
    const cond    = card.querySelector('.card-cond')?.innerText    || '';
    const details = card.querySelector('.card-detail-data')?.innerText || '';

    const backdrop = buildBackdrop('sopEditBackdrop');
    backdrop.innerHTML = `
        <div style="background:#fff;border-radius:14px;padding:28px 32px;width:580px;max-width:97%;max-height:90vh;overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.25);position:relative;">
            <button onclick="document.getElementById('sopEditBackdrop').remove()" style="position:absolute;top:10px;right:14px;background:none;border:none;font-size:1.3rem;cursor:pointer;">✕</button>
            <h3 style="margin:0 0 16px;font-size:1rem;color:#CB202D;">✏️ Edit SOP Block</h3>
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">TITLE</label>
            <input id="se-title" type="text" value="${esc(title)}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">CONDITION / TRIGGER</label>
            <input id="se-cond" type="text" value="${esc(cond)}" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.9rem;margin-bottom:12px;">
            <label style="font-size:.75rem;font-weight:700;color:#64748b;display:block;margin-bottom:4px;">FULL DETAILS</label>
            <textarea id="se-details" rows="7" style="width:100%;border:1.5px solid #e2e8f0;border-radius:7px;padding:9px 12px;font-family:inherit;font-size:.85rem;resize:vertical;margin-bottom:16px;">${esc(details)}</textarea>
            <div style="display:flex;gap:10px;">
                <button id="seSubmitBtn" style="flex:2;padding:11px;background:#CB202D;color:#fff;border:none;border-radius:8px;font-weight:800;font-family:inherit;cursor:pointer;font-size:.9rem;">Save Changes</button>
                <button onclick="deleteBlock(null,'${sopId}',document.getElementById('sopEditBackdrop'))" style="flex:1;padding:11px;background:#ffefef;color:#b23a3a;border:1px solid #fca5a5;border-radius:8px;font-weight:700;font-family:inherit;cursor:pointer;font-size:.85rem;">Delete</button>
            </div>
        </div>
    `;
    document.body.appendChild(backdrop);
    backdrop.addEventListener('click', e => { if (e.target === backdrop) backdrop.remove(); });

    document.getElementById('seSubmitBtn').addEventListener('click', async () => {
        const title   = document.getElementById('se-title').value.trim();
        const cond    = document.getElementById('se-cond').value.trim();
        const details = document.getElementById('se-details').value;
        if (!title) { showToast('Title required', 'warning'); return; }
        try {
            const res = await fetch(`/${SOP_LOB}/sop/update/${sopId}`, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title, condition: cond, action: details }),
                credentials: 'same-origin'
            });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || 'Update failed');
            showToast('SOP updated ✓', 'success');
            document.getElementById('sopEditBackdrop')?.remove();
            // Optimistic DOM update
            const h = card.querySelector('.card-header'); if (h) h.innerText = title;
            const c = card.querySelector('.card-cond');   if (c) c.innerText = cond;
            const d = card.querySelector('.card-detail-data'); if (d) d.innerText = details;
        } catch (err) {
            showToast('Error: ' + err.message, 'warning');
        }
    });
}

async function deleteBlock(card, overrideId, backdrop) {
    const sopId = overrideId || card?.dataset?.sopId;
    if (!sopId) { showToast('No SOP ID — cannot delete static card', 'warning'); return; }
    if (!confirm('Delete this SOP block permanently?')) return;
    try {
        const res = await fetch(`/${SOP_LOB}/sop/delete/${sopId}`, { method: 'DELETE', credentials: 'same-origin' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Delete failed');
        showToast('Block deleted');
        backdrop?.remove();
        (card || document.querySelector(`.sop-card[data-sop-id="${sopId}"]`))?.remove();
    } catch (err) {
        showToast('Error: ' + err.message, 'warning');
    }
}

function buildBackdrop(id) {
    document.getElementById(id)?.remove();
    const el = document.createElement('div');
    el.id = id;
    el.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9500;display:flex;align-items:center;justify-content:center;padding:16px;backdrop-filter:blur(3px);';
    return el;
}

/* ─── CSS for drag ghost ────────────────────────────────── */
const editStyle = document.createElement('style');
editStyle.textContent = `
    .sop-drag-ghost { opacity:.4; transform:rotate(1.5deg); }
    body[data-mode="edit"] .sop-card { cursor:grab; }
    body[data-mode="edit"] .sop-card:active { cursor:grabbing; }
`;
if (SOP_MODE === 'edit') {
    document.head.appendChild(editStyle);
    document.body.setAttribute('data-mode', 'edit');
}

</script>


        <span class="pb-version">v2025.02.20</span>
    </div>

    <!-- Live status pill -->
    <div class="pb-live-pill">
        <div class="pb-live-dot pending" id="pbLiveDot"></div>
        <span class="pb-live-text pending" id="pbLiveText">Connecting…</span>
    </div>

    <div class="pb-divider"></div>

    <!-- Viewer count -->

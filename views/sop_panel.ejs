function getCardDiffStatus(card) {
    if (!window.diffSnapshotData) return null;
    const snapCards = window.diffSnapshotData.cards || [];
    const match = snapCards.find(c => c.title.toLowerCase().trim() === card.title.toLowerCase().trim());
    if (!match) {
        return { className: 'diff-added', bg: '#dcfce7', color: '#15803d', label: 'Added' };
    }

    const t1 = `${card.condition}\n${card.action}\n${card.details}`;
    const t2 = `${match.condition}\n${match.action}\n${match.details}`;
    const pct = getTextDiffPercentage(t1, t2);

    if (pct === 0) return null;
    if (pct < 20) {
        return { className: 'diff-minor', bg: '#eff6ff', color: '#1d4ed8', label: 'Minor Edit' };
    } else {
        return { className: 'diff-major', bg: '#fff7ed', color: '#c2410c', label: 'Major Edit' };
    }
}

function getTextDiffPercentage(s1, s2) {
    s1 = s1 || ''; s2 = s2 || '';
    const len = Math.max(s1.length, s2.length);
    if (len === 0) return 0;
    return (levenshteinDistance(s1, s2) / len) * 100;
}

function levenshteinDistance(a, b) {
    const matrix = [];
    for (let i = 0; i <= b.length; i++) matrix[i] = [i];
    for (let j = 0; j <= a.length; j++) matrix[0][j] = j;
    for (let i = 1; i <= b.length; i++) {
        for (let j = 1; j <= a.length; j++) {
            if (b.charAt(i - 1) === a.charAt(j - 1)) {
                matrix[i][j] = matrix[i - 1][j - 1];
            } else {
                matrix[i][j] = Math.min(
                    matrix[i - 1][j - 1] + 1,
                    matrix[i][j - 1] + 1,
                    matrix[i - 1][j] + 1
                );
            }
        }
    }
    return matrix[b.length][a.length];
}

// Google Sheets Sync & Reconciliation
async function fetchAndReconcileSheet() {
    showToast('Fetching Google Sheet source...', 'info');
    try {
        const res = await fetch(`/${SOP_LOB}/sop/fetch-source`);
        const data = await res.json();
        if (data.success && data.data) {
            const rows = data.data;
            const reconciliation = [];
            const cards = window.SopDraftState.cards || [];

            rows.forEach(row => {
                const title = row.title || row.scenario || '';
                if (!title) return;
                const match = cards.find(c => c.title.toLowerCase().trim() === title.toLowerCase().trim());
                if (match) {
                    const condMatch = (row.condition || row.trigger || '').toLowerCase().trim() === (match.condition || '').toLowerCase().trim();
                    const actMatch = (row.action || '').toLowerCase().trim() === (match.action || '').toLowerCase().trim();
                    const detailsMatch = (row.details || row.sop || '').toLowerCase().trim() === (match.details || '').toLowerCase().trim();

                    if (condMatch && actMatch && detailsMatch) {
                        reconciliation.push({ title, mismatch: false });
                    } else {
                        reconciliation.push({ title, mismatch: true });
                    }
                }
            });

            window.sheetReconciliationData = reconciliation;
            renderSopLayout();
            closeSheetModal();

            let clearBtn = document.getElementById('sop-clear-reconcile-btn');
            if (!clearBtn) {
                clearBtn = document.createElement('button');
                clearBtn.id = 'sop-clear-reconcile-btn';
                clearBtn.className = 'sop-toolbar-btn btn-red';
                clearBtn.style.cssText = 'position:fixed; bottom:25px; left:220px; z-index:9999; box-shadow:0 4px 15px rgba(0,0,0,0.2);';
                clearBtn.innerHTML = '✕ Clear Sync Overlay';
                clearBtn.onclick = () => {
                    window.sheetReconciliationData = null;
                    renderSopLayout();
                    clearBtn.remove();
                };
                document.body.appendChild(clearBtn);
            }
            showToast('Sync Reconciliation check finished!', 'success');
        } else {
            throw new Error(data.error || 'Failed to fetch');
        }
    } catch (err) {
        showToast('Sync Error: ' + err.message, 'warning');
    }
}

// Save Sheet link URL via API
async function saveSheetUrl() {
    const url = document.getElementById('smUrlInput').value.trim();
    if (!isValidSheetUrl(url)) return;
    try {

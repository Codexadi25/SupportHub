<% if (user.role === 'admin' || user.role === 'vendor' || user.role === 'team_lead' || user.role === 'editor' || user.role === 'quality_analyst') { %>
<div class="admin-panel-container" style="padding: 20px; display: flex; flex-direction: column; gap: 24px; height: 100%; overflow-y: auto;">
  
  <div style="border-bottom: 1px solid var(--clr-border, #e2e8f0); padding-bottom: 12px;">
    <h2 style="margin: 0; font-size: 1.5rem; font-weight: 700; color: var(--clr-text-main, #1e293b); display: flex; align-items: center; gap: 8px;">
      <span>⚙️</span> AI Config & System Controls
    </h2>
    <p style="margin: 4px 0 0 0; font-size: 0.85rem; color: var(--clr-text-muted, #64748b);">
      Manage the core system prompt templates and dictionary compliance controls for AI-assisted canned responses.
    </p>
  </div>

  <!-- 1. System Prompt Configuration (Admin Only) -->
  <% if (user.role === 'admin') { %>
    <div class="admin-section" style="background: var(--clr-bg-card, #ffffff); border: 1px solid var(--clr-border, #e2e8f0); border-radius: 12px; padding: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
      <h3 style="margin: 0 0 8px 0; font-size: 1.1rem; font-weight: 700; color: var(--clr-text-main, #1e293b); display: flex; align-items: center; gap: 6px;">
        <span>📝</span> System Prompt Configuration
      </h3>
      <p style="margin: 0 0 12px 0; font-size: 0.85rem; color: var(--clr-text-muted, #64748b); line-height: 1.4;">
        Define the directives, rules, tone, and constraints that Gemini uses when generating canned responses. Use <strong>{{selectedTags}}</strong> for selected sentence chunks and <strong>{{extraContext}}</strong> for additional context input.
      </p>
      <div class="form-group" style="margin-bottom: 16px;">
        <textarea id="admin-prompt-textarea" rows="8" style="width: 100%; padding: 12px; border: 1px solid var(--clr-border, #cbd5e1); border-radius: 8px; font-family: monospace; font-size: 0.85rem; background: var(--clr-bg-card, #ffffff); color: var(--clr-text-main, #1e293b); resize: vertical; box-sizing: border-box;"></textarea>
      </div>
      <div style="display: flex; justify-content: flex-end;">
        <button id="btn-admin-prompt-save" class="action-btn" style="background: var(--clr-primary, #2563eb); color: white; border: none; padding: 10px 20px; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 0.85rem; box-shadow: 0 2px 6px rgba(37,99,235,0.15);">
          Save Prompt Template
        </button>
      </div>
    </div>
  <% } %>

  <!-- 2. AI Permitted Vocabulary & Library -->
  <div class="admin-section" style="background: var(--clr-bg-card, #ffffff); border: 1px solid var(--clr-border, #e2e8f0); border-radius: 12px; padding: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.02);">
    <h3 style="margin: 0 0 8px 0; font-size: 1.1rem; font-weight: 700; color: var(--clr-text-main, #1e293b); display: flex; align-items: center; gap: 6px;">
      <span>✨</span> AI Permitted Vocabulary & Library
    </h3>
    <p style="margin: 0 0 16px 0; font-size: 0.85rem; color: var(--clr-text-muted, #64748b); line-height: 1.4;">
      Control the vocabulary that AI is permitted to use when generating and rephrasing canned responses. Words can be manually added or synchronized from existing canned responses.
    </p>
    
    <% if (user.role === 'admin' || user.role === 'vendor') { %>
      <div style="display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; align-items: flex-end; background: var(--clr-bg-card, #f8fafc); padding: 16px; border-radius: 8px; border: 1px solid var(--clr-border, #e2e8f0);">
        <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0; display: flex; flex-direction: column; gap: 6px;">
          <label for="new-permitted-word" style="font-weight: 700; font-size: 0.85rem; color: var(--clr-text-main, #1e293b);">Add Permitted Word</label>
          <input type="text" id="new-permitted-word" placeholder="e.g. order, delivery, customer" style="padding: 8px 12px; width: 100%; border-radius: 6px; border: 1px solid var(--clr-border, #cbd5e1); background: var(--clr-bg-card, #ffffff); color: var(--clr-text-main, #1e293b); box-sizing: border-box; font-size: 0.85rem;">
        </div>
        <button id="btn-add-permitted-word" class="action-btn" style="height: 38px; padding: 0 16px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; font-size: 0.85rem; margin-top: 0; background: var(--clr-primary, #2563eb); border: none; border-radius: 6px; color: white; cursor: pointer;">
          <i class="bi bi-plus-circle"></i> Add Word
        </button>
        <button id="btn-sync-permitted-words" class="action-btn" style="height: 38px; background: #8b5cf6; padding: 0 16px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; font-size: 0.85rem; margin-top: 0; box-shadow: 0 4px 6px -1px rgba(139, 92, 246, 0.2); border: none; border-radius: 6px; color: white; cursor: pointer;">
          <i class="bi bi-arrow-repeat"></i> Sync from DB Cands
        </button>
      </div>
    <% } %>

    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px; justify-content: space-between; flex-wrap: wrap;">
      <span id="permitted-words-count" style="font-weight: 700; font-size: 0.9rem; color: var(--clr-text-muted, #475569);">Loading words...</span>
      <div style="display: flex; gap: 10px; align-items: center;">
        <label for="permitted-words-search" style="font-weight: 600; font-size: 12px; display: inline-block;">Filter Words:</label>
        <input id="permitted-words-search" type="search" placeholder="Search vocabulary..." style="padding: 6px 10px; border-radius: 6px; border: 1px solid var(--clr-border, #cbd5e1); background: var(--clr-bg-card, #ffffff); color: var(--clr-text-main, #1e293b); font-size: 13px;">
      </div>
    </div>

    <div class="panel" style="padding: 0; max-height: 300px; overflow-y: auto; border: 1px solid var(--clr-border, #e2e8f0); border-radius: 8px; background: var(--clr-bg-card, #ffffff);">
      <table class="admin-table" style="width: 100%; border-collapse: collapse; margin: 0;">
        <thead>
          <tr style="background: var(--clr-bg-card, #f8fafc); border-bottom: 1px solid var(--clr-border, #e2e8f0);">
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--clr-text-muted, #64748b);">Permitted Word</th>
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--clr-text-muted, #64748b);">Similar &amp; Inflected Forms</th>
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--clr-text-muted, #64748b);">Source</th>
            <% if (user.role === 'admin' || user.role === 'vendor') { %>
              <th style="padding: 10px 12px; text-align: center; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; width: 80px; color: var(--clr-text-muted, #64748b);">Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="permitted-words-table-body">
          <!-- Populated dynamically via JS -->
        </tbody>
      </table>
    </div>
  </div>

</div>
<% } %>

<style>
    .notif-panel-wrapper {
        max-width: 800px;
        overflow-y: auto;
        height: 100%;
        margin: 4px auto;
        padding: 0 10px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        
    }
    
    .notif-card {
        background: rgba(255, 255, 255, 0.7);
        backdrop-filter: blur(24px);
        -webkit-backdrop-filter: blur(24px);
        border-radius: 20px;
        padding: 40px;
        box-shadow: 
            0 20px 40px rgba(0, 0, 0, 0.08),
            0 1px 3px rgba(0,0,0,0.05),
            inset 0 1px 0 rgba(255, 255, 255, 0.6);
        border: 1px solid rgba(255, 255, 255, 0.5);
        position: relative;
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), box-shadow 0.3s ease;
        z-index: 10000;
    }
    
    body.dark-mode .notif-card {
        background: rgba(30, 41, 59, 0.6);
        border: 1px solid rgba(255,255,255,0.1);
        box-shadow: 
            0 20px 40px rgba(0, 0, 0, 0.4),
            inset 0 1px 0 rgba(255, 255, 255, 0.05);
    }
    
    .notif-card::before {
        content: '';
        position: absolute;
        top: -100px;
        right: -100px;
        width: 300px;
        height: 300px;
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(255,255,255,0) 70%);
        border-radius: 50%;
        pointer-events: none;
    }

    body.dark-mode .notif-card::before {
        background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, rgba(30, 41, 59, 0) 70%);
    }

    .notif-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 35px;
    }
    
    .notif-icon-box {
        width: 56px;
        height: 56px;
        border-radius: 16px;
        background: linear-gradient(135deg, #6366f1, #8b5cf6);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: white;
        box-shadow: 0 8px 16px rgba(99, 102, 241, 0.3);
    }

    .notif-title-group h2 {
        margin: 0;
        font-size: 1.75rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.02em;
    }

    body.dark-mode .notif-title-group h2 {
        color: #f8fafc;
    }

    .notif-title-group p {
        margin: 4px 0 0 0;
        font-size: 0.95rem;
        color: #64748b;
    }

    body.dark-mode .notif-title-group p {
        color: #94a3b8;
    }

    .notif-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .notif-form-full {
        grid-column: span 2;
    }

    .notif-field {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .notif-field label {
        font-size: 0.875rem;
        font-weight: 600;
        color: #334155;
        margin-left: 2px;
    }
    
    body.dark-mode .notif-field label {
        color: #cbd5e1;
    }

    .notif-input {
        width: 100%;
        padding: 12px 16px;
        border-radius: 12px;
        border: 1px solid rgba(203, 213, 225, 0.6);
        background: rgba(255, 255, 255, 0.8);
        color: #0f172a;
        font-size: 0.95rem;
        font-family: inherit;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }
    
    body.dark-mode .notif-input {
        background: rgba(15, 23, 42, 0.4);
        border-color: rgba(71, 85, 105, 0.5);
        color: #f8fafc;
    }

    .notif-input:focus {
        outline: none;
        border-color: #6366f1;
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
        background: #fff;
    }
    
    body.dark-mode .notif-input:focus {
        background: rgba(15, 23, 42, 0.8);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
    }

    .notif-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .notif-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 16px;
    }

    .notif-btn-submit {
        background: linear-gradient(135deg, #4f46e5, #7c3aed);
        color: white;
        border: none;
        padding: 14px 28px;
        border-radius: 12px;
        font-size: 1rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 10px;
        transition: all 0.2s ease;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
    }

    .notif-btn-submit:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(79, 70, 229, 0.4);
    }

    .notif-btn-submit:active {
        transform: translateY(0);
    }
</style>

<div class="notif-panel-wrapper">
    <div class="notif-card">
        <div class="notif-header">
            <div class="notif-icon-box">🔔</div>
            <div class="notif-title-group">
                <h2>Send Targeted Notification</h2>
                <p>Dispatch direct notification alerts or announcements to specific users.</p>
            </div>
        </div>

        <form id="send-notification-form">
            <div class="notif-form-grid">
                
                <div class="notif-field">
                    <label for="notif-recipient">Recipient User *</label>
                    <select id="notif-recipient" name="recipientId" required class="notif-input">
                        <option value="">-- Select Recipient --</option>
                        <option value="all">Broadcast to All Users</option>
                    </select>
                </div>

                <div class="notif-field">
                    <label for="notif-type">Notification Type *</label>
                    <select id="notif-type" name="type" required class="notif-input">
                        <option value="username_change">Username Change</option>
                        <option value="password_change">Password Change/Update</option>
                        <option value="role_change">Role/Department Access</option>
                        <option value="app_update">App Update</option>
                        <option value="sop_update">SOP Update</option>
                        <option value="daily_briefing">Daily Briefing</option>
                        <option value="other" selected>Other Announcement</option>
                    </select>
                </div>

                <div class="notif-field notif-form-full">
                    <label for="notif-title">Title *</label>
                    <input type="text" id="notif-title" name="title" required maxlength="150" placeholder="e.g. Password Updated Successfully" class="notif-input">
                </div>

                <div class="notif-field notif-form-full">
                    <label for="notif-content-type">Message Format *</label>
                    <select id="notif-content-type" name="contentType" required class="notif-input">
                        <option value="plain" selected>Plain Text</option>
                        <option value="html">HTML</option>
                        <option value="markdown">Markdown</option>
                    </select>
                </div>

                <div class="notif-field notif-form-full">
                    <label for="notif-content">Message Content *</label>
                    <textarea id="notif-content" name="content" required placeholder="Type the message details here..." class="notif-input notif-textarea"></textarea>
                </div>

            </div>

            <div class="notif-actions">
                <button type="submit" class="notif-btn-submit" id="notif-submit-btn">
                    <span>Send Notification</span> 
                    <i class="fa fa-paper-plane"></i>
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const recipientSelect = document.getElementById('notif-recipient');
        const form = document.getElementById('send-notification-form');
        
        async function loadRecipients() {
            try {
                const res = await fetch('/api/admin/users');
                if (!res.ok) throw new Error('Failed to fetch users');
                const users = await res.json();
                
                recipientSelect.innerHTML = '<option value="">-- Select Recipient --</option><option value="all">Broadcast to All Users</option>';
                
                users.forEach(u => {
                    const option = document.createElement('option');
                    option.value = u._id || u.id;
                    option.textContent = `${u.displayName || u.username} (${u.role.replace('_',' ')} · ${u.department || 'no dept'})`;
                    recipientSelect.appendChild(option);
                });
            } catch (err) {
                console.error('[SendNotifPanel] Error loading users:', err);
            }
        }
        
        if (recipientSelect) {
            loadRecipients();
        }

        if (form) {
            form.addEventListener('submit', async function(e) {
                e.preventDefault();
                
                const recipientId = document.getElementById('notif-recipient').value;
                const type = document.getElementById('notif-type').value;
                const title = document.getElementById('notif-title').value.trim();
                const content = document.getElementById('notif-content').value.trim();
                const contentType = document.getElementById('notif-content-type').value;
                
                if (!recipientId || !title || !content) {
                    alert('Please fill out all required fields.');
                    return;
                }
                
                try {
                    const userDept = '<%= (user.department || "zomato").toLowerCase().trim() %>';
                    const res = await fetch(`/api/${userDept}/notifications`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            recipientId,
                            type,
                            title,
                            content,
                            contentType
                        })
                    });
                    
                    const data = await res.json();
                    if (!res.ok) {
                        throw new Error(data.message || 'Failed to dispatch notification');
                    }
                    
                    alert('Notification sent successfully!');
                    form.reset();
                    
                    if (window.loadNotifications) {
                        window.loadNotifications();
                    }
                } catch (err) {
                    alert('Error: ' + err.message);
                }
            });
        }
    });
</script>

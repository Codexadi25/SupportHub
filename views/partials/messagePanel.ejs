<div class="message-search-box" style="padding: 0 0 10px 0; border-bottom: 1px solid #e2e8f0;">
    <input type="text" id="message-search" placeholder="Search group chat..." style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid #cbd5e1; background: #f8fafc; color: #333; outline: none;">
</div>

<div class="chat-messages" id="message-scroll-area">
    <div id="message-list-container" style="display: flex; flex-direction: column; gap: 10px; margin-top: 10px;">
        <div class="loading-indicator" style="text-align:center; padding:20px; color:#64748b;">Loading group messages...</div>
    </div>
</div>

<div class="chat-input-container">
    <form id="message-form" style="display:flex; width: 100%; gap: 8px;">
        <textarea id="message-content" name="content" class="chat-input" placeholder="Type a message to the group..." rows="2" required></textarea>
        <button type="submit" class="chat-send-btn" id="send-message-btn">Send</button>
    </form>
</div>

<script src="/js/messages.js"></script>

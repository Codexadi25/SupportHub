<div class="panel-header" style="display:flex; justify-content:space-between; align-items:center;">
  <h2>Admin Dashboard</h2>
  <a href="/performance/dashboard" target="_blank" class="action-btn" style="text-decoration:none; display:inline-flex; align-items:center; gap:8px; background: var(--primary, #2563eb); color: #fff; padding: 10px 18px; border-radius: 8px; font-weight: 600; font-size: 0.95rem; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
    📊 Open Performance Dashboard
  </a>
</div>

<div class="content-scroll-area admin-forms">
<% if (user.role === 'admin' || user.role === 'vendor') { %>
  <div class="admin-section">
    <h3>Bulk Upload Cands (JSON) <button id="toggle-json-sample" class="link-btn" onclick="toggleJsonSample()">Show Sample</button></h3>
    <p>Upload canned responses from a JSON file. Choose whether to append to existing data or replace all data.</p>

    <script>
      function toggleJsonSample() {
        const jsonSample = document.getElementById('json-sample');
        jsonSample.style.display = jsonSample.style.display === 'none' ? 'block' : 'none';
      }
    </script>
    <div id="json-sample" style="display: none;">
      <pre class="code-block">
{
  "categories": [
    {
      "title": "Category Title",
      "templates": [
        {
          "tags": ["tag1", "tag2"],
          "text": "This is the first canned response text."
        },
        {
          "tags": ["tag1", "tag3"],
          "text": "This is the second canned response text."
        }
      ]
    },
    {
      "title": "Category Title Two",
      "templates": [
        {
          "tags": ["tag4"],
          "text": "Another response in a different category."
        }
      ]
    }
  ]
}
      </pre>
    </div>

    <form id="bulk-upload-form" enctype="multipart/form-data">
      <div class="form-group">
        <label for="upload-mode">Upload Mode:</label>
        <select id="upload-mode" name="mode" required>
          <option value="append" selected>Append to existing data (recommended)</option>
          <option value="replace">Replace all existing data</option>
        </select>
      </div>
      <div class="form-group">
        <label for="jsonFile">JSON File:</label>
        <input type="file" name="jsonFile" id="jsonFile" accept=".json" required>
      </div>
      <button type="submit" class="action-btn">Upload Canned Responses</button>
    </form>
  </div>
<% } %>

<% if (user.role === 'admin') { %>
  <div class="admin-section">
    <h3>Create New Department</h3>
    <p>Admins can create a new department here, which can then be assigned to users.</p>
    <form id="create-dept-form">
      <div class="form-group" style="margin-bottom: 8px;">
        <label for="dept-name">Department Name:</label>
        <input type="text" id="dept-name" placeholder="e.g. Blinkit Ops" required style="padding:8px;width:100%;box-sizing:border-box;border-radius:6px;border:1px solid #ddd;">
      </div>
      <div class="form-group" style="margin-bottom: 8px;">
        <label for="dept-desc">Description (Optional):</label>
        <input type="text" id="dept-desc" placeholder="e.g. Blinkit operations team" style="padding:8px;width:100%;box-sizing:border-box;border-radius:6px;border:1px solid #ddd;">
      </div>
      <button type="submit" class="action-btn">Create Department</button>
    </form>
  </div>
<% } %>
  <div class="admin-section">
    <h3>Bulk Create Users</h3>
    <p>Enter usernames, one per line. Initial password will equal username.</p>
    <form id="bulk-user-form">
      <textarea id="bulk-usernames" rows="5" placeholder="user1&#10;user2&#10;user3"></textarea>
      <button type="submit" class="action-btn">Create Users</button>
    </form>

    <div id="bulk-user-results" class="results-box" style="display:none;margin-top:8px;">
      <div style="display:flex;align-items:center;gap:8px;">
        <h4 style="margin:0">Generated Credentials</h4>
        <button id="copy-creds-btn" class="action-btn">Copy All</button>
      </div>
      <pre id="new-creds-output" style="white-space:pre-wrap;"></pre>
    </div>
  </div>

<% if (user.role === 'admin' || user.role === 'vendor' || user.role === 'editor' || user.role === 'team_lead' || user.role === 'quality_analyst') { %>
  <div class="admin-section">
    <h3>✨ AI Permitted Vocabulary & Library</h3>
    <p>Control the vocabulary that AI is permitted to use when generating and rephrasing canned responses. Words can be manually added or synchronized from existing canned responses.</p>
    
    <% if (user.role === 'admin' || user.role === 'vendor') { %>
      <div style="display: flex; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; align-items: flex-end; background: var(--bg-light, #f8fafc); padding: 16px; border-radius: 8px; border: 1px solid var(--border-color, #e2e8f0);">
        <div class="form-group" style="flex: 1; min-width: 200px; margin-bottom: 0;">
          <label for="new-permitted-word" style="font-weight: 700; font-size: 0.85rem; margin-bottom: 6px; display: block;">Add Permitted Word</label>
          <input type="text" id="new-permitted-word" placeholder="e.g. order, delivery, customer" style="padding: 8px 12px; width: 100%; border-radius: 6px; border: 1px solid var(--border-color, #cbd5e1); box-sizing: border-box;">
        </div>
        <button id="btn-add-permitted-word" class="action-btn" style="height: 38px; padding: 0 16px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; font-size: 0.85rem; margin-top: 0;">
          <i class="bi bi-plus-circle"></i> Add Word
        </button>
        <button id="btn-sync-permitted-words" class="action-btn" style="height: 38px; background: #8b5cf6; padding: 0 16px; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 700; font-size: 0.85rem; margin-top: 0; box-shadow: 0 4px 6px -1px rgba(139, 92, 246, 0.2);">
          <i class="bi bi-arrow-repeat"></i> Sync from DB Cands
        </button>
      </div>
    <% } %>

    <div style="display: flex; gap: 10px; align-items: center; margin-bottom: 12px; justify-content: space-between; flex-wrap: wrap;">
      <span id="permitted-words-count" style="font-weight: 700; font-size: 0.9rem; color: var(--text-muted, #475569);">Loading words...</span>
      <div style="display: flex; gap: 10px; align-items: center;">
        <label for="permitted-words-search" style="font-weight: 600; font-size: 12px; display: inline-block;">Filter Words:</label>
        <input id="permitted-words-search" type="search" placeholder="Search vocabulary..." style="padding: 6px 10px; border-radius: 6px; border: 1px solid var(--border-color, #cbd5e1); font-size: 13px;">
      </div>
    </div>

    <div class="panel" style="padding: 0; max-height: 300px; overflow-y: auto; border: 1px solid var(--border-color, #e2e8f0); border-radius: 8px;">
      <table class="admin-table" style="width: 100%; border-collapse: collapse; margin: 0;">
        <thead>
          <tr style="background: var(--bg-light, #f8fafc); border-bottom: 1px solid var(--border-color, #e2e8f0);">
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Permitted Word</th>
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Similar &amp; Inflected Forms</th>
            <th style="padding: 10px 12px; text-align: left; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em;">Source</th>
            <% if (user.role === 'admin' || user.role === 'vendor') { %>
              <th style="padding: 10px 12px; text-align: center; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.05em; width: 80px;">Action</th>
            <% } %>
          </tr>
        </thead>
        <tbody id="permitted-words-table-body">
          <!-- Populated dynamically via JS -->
        </tbody>
      </table>
    </div>
  </div>
<% } %>

  <div class="admin-section">
    <h3>User Directory & Activity Management</h3>
    <p>Real-time presence tracking and account management.</p>

    <!-- Connection Status Indicator -->
    <div class="connection-status" style="margin-bottom:12px;text-align:left;">
      <span id="connection-indicator" class="status-indicator">🔴 Disconnected</span>
    </div>

    <div class="user-controls" style="display:flex;gap:10px;align-items:center;margin-bottom:12px;flex-wrap:wrap;">
      <button id="refreshUsersBtn" class="action-btn"><i class="bi bi-arrow-clockwise"></i> Refresh</button>
      <button id="btn-toggle-presence-collapse" class="btn btn-warning" onclick="togglePresenceCollapse()"><i class="bi bi-arrows-collapse"></i> Show Logged-in Only</button>
      
      <% if (user.role === 'admin') { %>
        <button id="cleanupLogsBtn" class="action-btn"><i class="bi bi-trash"></i> Cleanup Logs</button>
        <button id="cleanupMessagesBtn" class="action-btn"><i class="bi bi-envelope-x"></i> Cleanup Messages</button>
      <% } %>

      <div style="margin-left:auto;display:flex;gap:10px;align-items:center;">
        <label for="admin-user-search" style="font-weight:600;font-size:12px;">Filter:</label>
        <input id="admin-user-search" type="search" placeholder="Filter users..." style="padding:6px;border-radius:6px;border:1px solid #ddd">
      </div>
    </div>

    <div id="admin-users-container" class="panel" style="padding:0;min-height:120px;overflow-x:auto;">
      <table id="admin-users-table" style="width:100%;border-collapse:collapse;min-width:900px;">
        <thead>
          <tr style="background:#fafafa">
            <th style="padding:10px 8px;text-align:left">Username</th>
            <th style="padding:10px 8px;text-align:left">Status</th>
            <th style="padding:10px 8px;text-align:left">Password</th>
            <th style="padding:10px 8px;text-align:left">Role</th>
            <th style="padding:10px 8px;text-align:left">Department</th>
            <th style="padding:10px 8px;text-align:left">Aligned TL</th>
            <th style="padding:10px 8px;text-align:left">Modified At</th>
            <th style="padding:10px 8px;text-align:left">Actions</th>
          </tr>
        </thead>
        <tbody id="admin-users-table-body">
            <!-- Populated dynamically via JS -->
        </tbody>
      </table>
    </div>
  </div>

</div>

<script src="/js/admin.js"></script>
                      <% if (user.role !== 'new') { %>
                        <div id="SmartSOP" class="tab-content">
                          <iframe src="/<%= (user.department || 'zomato').toLowerCase().trim() %>/sop/view" style="width:100%;height:850px;border:0;" title="Smart SOP Panel"></iframe>
                        </div>
                      <% } else { %>
                        <div id="SmartSOP" class="tab-content">
                          <span class="no-admin">⚠️ Forbidden: SOP Panel access requires elevated privileges.</span>
                        </div>
                      <% } %>

                      <% if (user.role === 'admin' || user.role === 'quality_analyst') { %>
                        <div id="SOPBuilder" class="tab-content">
                          <iframe src="/<%= (user.department || 'zomato').toLowerCase().trim() %>/sop/edit" style="width:100%;height:850px;border:0;" title="SOP Builder Panel"></iframe>
                        </div>
                      <% } %>

                    <% if (user.role === 'vendor' || user.role === 'admin') { %>
                      <div id="Logger" class="tab-content">
                        <%- include('partials/loggerPanel') %>

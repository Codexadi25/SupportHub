                    <span class="notification-bell" id="message-notification-bell" style="display: none;">
                        🔔
                        <span class="notification-count" id="unread-message-count">0</span>
                    </span>
                </button>
                <% if (user.role !== 'new') { %>
                  <button class="tab-link sop-btn" target="_blank" data-tab="SmartSOP">Smart SOP</button>
                <% } %>

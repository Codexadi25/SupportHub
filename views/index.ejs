                  </div>
                </div>
              <% } else { %>
              <div class="tabs">
                <button class="tab-link active" data-tab="Cands">Cands</button>
                <button class="tab-link" data-tab="PNs">Private Notes</button>
                <button class="tab-link" data-tab="Feedback">Feedback</button>

            <aside class="right-panel">
                 <%- include('partials/calculator') %>
            </aside>
        </main>
    </div>
    <%- include('partials/footer') %>
    
    <div id="form-modal">
        <div id="modal-box">
            <button class="modal-close-btn" aria-label="Close">&times;</button>
            <h3 id="modal-title" style="font-size:1rem;font-weight:700;margin-bottom:.25rem;">Modal Title</h3>
            <form id="modal-form"></form>
        </div>
    </div>

    <!-- User Profile Settings Modal -->
    <div id="profile-settings-modal" class="profile-modal-overlay">
        <div class="profile-modal-box">
            <div class="profile-modal-header">
                <h3><i class="bi bi-person-gear"></i> User Profile Settings</h3>
                <button class="modal-close-btn" onclick="closeProfileModal()">&times;</button>
            </div>
            
            <form id="profile-settings-form" onsubmit="saveProfileSettings(event)">
                <div class="profile-modal-body">
                    <div class="profile-avatar-wrapper">
                        <div class="profile-avatar-preview" id="profile-avatar-preview">
                            <% if (user.image || user.profilePic) { %>
                                <%- user.image || user.profilePic %>
                            <% } else { %>
                                <%= (user.displayName || user.profileName || user.username).charAt(0).toUpperCase() %>
                            <% } %>
                        </div>
                        <label class="avatar-upload-btn">
                            <i class="bi bi-camera-fill"></i> Upload Custom Image
                            <input type="file" id="profile-pic-input" accept=".png,.jpg,.jpeg,.svg" style="display:none;">
                        </label>
                        <div style="font-size:0.75rem;color:var(--text-muted);text-align:center;">
                            (Upload PNG/JPG to auto-convert to SVG vector text format)
                        </div>
                    </div>

                    <div class="form-group">
                        <label for="profile-username"><i class="bi bi-person-fill"></i> Username (You can change once in 14-days)</label>
                        <input type="text" id="profile-username" value="<%= user.username %>" required style="width:100%;padding:8px;border-radius:6px;border:1px solid var(--border);" oninput="validateProfileUsername(this)">
                        <div id="profile-username-warning" style="color: #ef4444; font-size: 0.8rem; margin-top: 4px; display: none;">Username can't contain special character except "_underscore_"</div>
                    </div>

                    <div class="form-group">
                        <label for="profile-name"><i class="bi bi-person-fill-check"></i> Display Name</label>
                        <input type="text" id="profile-name" value="<%= user.profileName || '' %>" required placeholder="e.g. Steve Smith" style="width:100%;padding:8px;border-radius:6px;border:1px solid var(--border);">
                    </div>
                    <div class="form-group">
                        <label for="profile-email"><i class="bi bi-envelope-fill"></i> Email ID</label>
                        <input type="email" id="profile-email" value="<%= user.email || '' %>" required placeholder="e.g. yourname@gmail.com" style="width:100%;padding:8px;border-radius:6px;border:1px solid var(--border);">
                    </div>

                    <div class="form-group">
                        <label><i class="bi bi-type"></i> Screen Font Size</label>
                        <div class="font-size-buttons">
                            <button type="button" class="font-size-btn" data-size="small">Small</button>
                            <button type="button" class="font-size-btn" data-size="medium">Medium</button>
                            <button type="button" class="font-size-btn" data-size="large">Large</button>
                            <button type="button" class="font-size-btn" data-size="xlarge">Extra Large</button>
                        </div>
                        <input type="hidden" id="profile-font-size" value="<%= user.fontSize || 'medium' %>">
                    </div>

                    <div class="form-group">
                        <label><i class="bi bi-palette-fill"></i> UI Primary Color</label>
                        <div class="theme-swatches" style="display:flex;align-items:center;gap:10px;">
                            <div class="theme-swatch" data-color="#2563eb" style="background:#2563eb;" title="Classic Blue"></div>
                            <div class="theme-swatch" data-color="#7c3aed" style="background:#7c3aed;" title="Sleek Purple"></div>
                            <div class="theme-swatch" data-color="#16a34a" style="background:#16a34a;" title="Emerald Green"></div>
                            <div class="theme-swatch" data-color="#ea580c" style="background:#ea580c;" title="Vibrant Orange"></div>
                            <div class="theme-swatch" data-color="#db2777" style="background:#db2777;" title="Rose Pink"></div>
                            <!-- Custom hex color picker -->
                            <input type="color" id="profile-ui-color-picker" value="<%= user.uiColor || '#2563eb' %>" style="width:34px;height:34px;border:none;border-radius:50%;cursor:pointer;padding:0;background:none;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Custom Color">
                        </div>
                        <input type="hidden" id="profile-ui-color" value="<%= user.uiColor || '#2563eb' %>">
                    </div>

                    <div class="form-group">
                        <label><i class="bi bi-palette2"></i> Ambient Background Color</label>
                        <div class="bg-swatches" style="display:flex;align-items:center;gap:10px;margin-top:8px;">
                            <div class="bg-swatch" data-bg="#f1f5f9" style="background:#f1f5f9;width:34px;height:34px;border-radius:50%;cursor:pointer;border:2px solid transparent;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Light Slate"></div>
                            <div class="bg-swatch" data-bg="#fdfbf7" style="background:#fdfbf7;width:34px;height:34px;border-radius:50%;cursor:pointer;border:2px solid transparent;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Warm Cream"></div>
                            <div class="bg-swatch" data-bg="#1e293b" style="background:#1e293b;width:34px;height:34px;border-radius:50%;cursor:pointer;border:2px solid transparent;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Dark Slate"></div>
                            <div class="bg-swatch" data-bg="#0f172a" style="background:#0f172a;width:34px;height:34px;border-radius:50%;cursor:pointer;border:2px solid transparent;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Midnight Dark"></div>
                            <!-- Custom background color picker -->
                            <input type="color" id="profile-bg-color-picker" value="<%= user.bgColor || '#f1f5f9' %>" style="width:34px;height:34px;border:none;border-radius:50%;cursor:pointer;padding:0;background:none;box-shadow:0 2px 5px rgba(0,0,0,0.15);" title="Custom Background">
                        </div>
                        <input type="hidden" id="profile-bg-color" value="<%= user.bgColor || '' %>">
                    </div>

                    <div class="form-group night-mode-toggle-group">
                        <span class="night-mode-label"><i class="bi bi-moon-stars-fill"></i> Night Mode (Ambient & Soft)</span>
                        <label class="switch">
                            <input type="checkbox" id="profile-night-mode" <%= user.nightMode ? 'checked' : '' %>>
                            <span class="slider round"></span>
                        </label>
                    </div>

                    <div style="margin-top:1.5rem;font-size:0.8rem;color:var(--text-muted);display:flex;align-items:center;justify-content:space-between;background:var(--surface-alt);padding:8px 12px;border-radius:6px;border:1px dashed var(--border);">
                        <span><i class="bi bi-laptop"></i> Device IP:</span>
                        <strong id="profile-device-ip" style="color:var(--text);"><%= user.lastActiveIp || '127.0.0.1' %></strong>
                    </div>
                </div>

                <div class="profile-footer">
                    <button type="button" class="btn" onclick="closeProfileModal()" style="background:#e2e8f0;color:#333;">Cancel</button>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- Version History Modal                                               -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <div id="version-history-modal" class="vh-overlay" onclick="closeVersionHistoryModal(event)" role="dialog" aria-modal="true" aria-label="Version History" style="display:none;">
        <div class="vh-modal" onclick="event.stopPropagation()">
            <div class="vh-header">
                <div class="vh-header-left">
                    <span class="vh-badge">Changelog</span>
                    <h2 class="vh-title">Version History</h2>
                    <p class="vh-subtitle">Every commit, beautifully logged.</p>
                </div>
                <button class="vh-close-btn" onclick="closeVersionHistoryModal()" aria-label="Close version history">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <div class="vh-body">
                <div id="version-timeline" class="vh-timeline">
                    <!-- Populated dynamically by main.js -->
                    <div class="vh-loading">
                        <div class="vh-spinner"></div>
                        <span>Loading history…</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="toast-container"></div>

    <!-- ── Offline / Weak Connection Alert ───────────────────────────── -->
    <div id="offline-banner" style="display:none;position:fixed;top:0;left:0;right:0;z-index:9999;
         background:linear-gradient(90deg,#dc2626,#b91c1c);color:#fff;
         text-align:center;padding:9px 16px;font-size:.85rem;font-weight:600;
         letter-spacing:.2px;box-shadow:0 2px 8px rgba(0,0,0,.25);
         display:none;align-items:center;justify-content:center;gap:8px;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
        <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
      </svg>
      ⚡ Weak or No Internet Connection — Some features may not work properly.
    </div>
    <script src="/js/presenceBar.js"></script>
    <script src="/js/profile.js"></script>
    <script>
        // ── Session globals ───────────────────────────────────────────────
        window.currentUserId   = '<%= user.id %>';
        window.currentUserRole = '<%= user.role %>';
        window.currentUsername = '<%= user.username %>';
        window.currentUserDept = '<%= user.department || "general" %>';
        window.currentUserEmail = '<%= user.email || "" %>';
        window.currentUserProfilePic = `<%- user.image || user.profilePic || "" %>`;
        window.currentUserFontSize = '<%= user.fontSize || "medium" %>';
        window.currentUserUiColor = '<%= user.uiColor || "#2563eb" %>';
        window.currentUserNightMode = <%= user.nightMode || false %>;
        window.currentUserProfileName = '<%= user.profileName || "" %>';
        window.currentUserDisplayName = '<%= user.displayName || "" %>';
        window.currentUserBgColor = '<%= user.bgColor || "" %>';

        // Click-to-copy for cand items and PN cards
        document.addEventListener('click', function(e) {
            const candItem = e.target.closest('.cand-item');
            const pnCard   = e.target.closest('.pn-card');

            if (candItem && !e.target.closest('button') && !e.target.closest('a')) {
                const text = candItem.querySelector('.cand-text')?.textContent?.trim();
                if (text) {
                    navigator.clipboard.writeText(text).then(() => {
                        candItem.style.boxShadow = '0 0 0 2px #2563eb';
                        setTimeout(() => candItem.style.boxShadow = '', 800);
                    }).catch(() => {});
                }
            }

            if (pnCard && !e.target.closest('button') && !e.target.closest('a')) {
                const text = pnCard.querySelector('.pn-card-body')?.textContent?.trim();
                if (text) {
                    navigator.clipboard.writeText(text).then(() => {
                        // GitHub-style ✓ Copied badge
                        let badge = pnCard.querySelector('.pn-copied-badge');
                        if (!badge) {
                            badge = document.createElement('span');
                            badge.className = 'pn-copied-badge';
                            badge.innerHTML = '&#10003; Copied';
                            pnCard.appendChild(badge);
                        }
                        badge.classList.add('pn-copied-badge--visible');
                        setTimeout(() => badge.classList.remove('pn-copied-badge--visible'), 1600);
                    }).catch(() => {});
                }
            }
        });

        // ── Initialize Modular Presence Bar ───────────────────────────────
        // Initialize real-time presence tracking for active users
        const presenceBar = new PresenceBar({
            username: window.currentUsername,
            department: window.currentUserDept,
            role: window.currentUserRole,
            avatarsElementId: 'auAvatars',
            overflowElementId: 'auOverflow',
            moreButtonId: 'auMoreBtn',
            moreCountId: 'auMoreCount',
            dropdownId: 'auDropdown'
        });
    </script>

    <script>
    // ── Offline / Weak Connection Detection ──────────────────────────────
    (function() {
        const banner = document.getElementById('offline-banner');
        function showBanner() { if (banner) banner.style.display = 'flex'; }
        function hideBanner() { if (banner) banner.style.display = 'none'; }
        window.addEventListener('offline', showBanner);
        window.addEventListener('online',  hideBanner);
        if (!navigator.onLine) showBanner();
    })();
    </script>
    <script src="/js/main.js"></script>
    <script src="/js/notices.js"></script>
    <!-- Feature Guide — loads last so all UI elements are in DOM -->
    <script src="/js/guide.js"></script>
</body>
</html>

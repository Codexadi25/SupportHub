                  </svg>
                </a>
            </div>
        </header>
        <main class="main-content">
            <div class="left-panel">
              <% if (user.role === 'new') { %>
                <div class="content-scroll-area" style="display:flex;align-items:center;justify-content:center;height:100%;">
                  <div style="max-width:700px;text-align:center;padding:24px;border:1px dashed #e2e8f0;border-radius:12px;background:#fff;">

<!DOCTYPE html>
<html lang="en">
    <title>Support Hub - Tools | <% if (user.role === 'admin' || user.role === 'editor') { %>
            Dashboard
        <% } else { %>
            User App
        <% } %>
    </title>
    <link rel="icon" href="favicon.ico" type="image/x-icon">
    <link rel="shortcut icon" href="favicon.ico" type="image/x-icon">    
    <link rel="icon" type="image/png" sizes="192x192" href="favicon.ico">    
    <link rel="icon" type="image/png" sizes="512x512" href="favicon.ico">
    <link rel="apple-touch-icon" href="favicon.ico">

    <meta property="og:title" content="Support Hub - Tools" />
    <meta property="og:description" content="Internal Cands, Tools & Docs." />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://github.com/Codexadi25/SupportHub/blob/main/public/icon.svg" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Support Hub - Tools" />
    <meta name="twitter:description" content="Internal Cands, Tools & Docs." />
    <meta name="twitter:image" content="https://github.com/Codexadi25/SupportHub/blob/main/public/icon.svg" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="/css/feedback.css">
    <link rel="stylesheet" href="/css/messages.css">
    <link rel="stylesheet" href="/css/versionHistory.css">
    <link rel="stylesheet" href="/css/guide.css">
<head>
    <%- include('partials/header') %>
    <script>
        // Apply saved profile settings instantly on load to prevent flickering
        (function() {
            const fontSize = '<%= user.fontSize || "medium" %>';
            const uiColor = '<%= user.uiColor || "#2563eb" %>';
            const nightMode = <%= user.nightMode || false %>;
            const bgColor = '<%= user.bgColor || "" %>';

            // Apply font scale
            const sizeMap = {
                small: '0.85',
                medium: '1.0',
                large: '1.15',
                xlarge: '1.3'
            };
            const fontScale = sizeMap[fontSize] || '1.0';
            document.documentElement.style.setProperty('--font-scale', fontScale);

            // Apply UI Color
            if (uiColor) {
                document.documentElement.style.setProperty('--primary', uiColor);
                document.documentElement.style.setProperty('--primary-color', uiColor);
            }

            // Apply ambient background color
            if (bgColor) {
                document.documentElement.style.setProperty('--bg', bgColor);
            }

            // Apply night mode
            if (nightMode) {
                document.documentElement.classList.add('night-mode');
                document.addEventListener('DOMContentLoaded', function() {
                    document.body.classList.add('night-mode');
                });
            }
        })();
    </script>
    <!-- Firebase Realtime Database (compat CDN) -->
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.12.0/firebase-database-compat.js"></script>
</head>
<body>
    <div class="app-wrapper">
        <header class="top-bar">
            <h1><img src="icon.svg" alt="S" style="height: 3rem; width: auto; vertical-align: -1rem; transform: rotate(25deg);">upport Hub</h1>
            <div class="search-container-modern">
                <input type="text" id="searchInput" placeholder="Search templates or tags...">
            </div>

            <!-- Active Users from same department (Firebase RTDB) -->
            <div class="active-users-bar" id="activeUsersBar" title="Active colleagues">
                <div class="au-avatars" id="auAvatars"><!-- populated by Firebase --></div>
                <div class="au-overflow" id="auOverflow" style="display:none">
                    <div class="au-avatar au-more" id="auMoreBtn" title="">+<span id="auMoreCount">0</span></div>
                    <div class="au-dropdown" id="auDropdown" style="display:none;"></div>
                </div>
            </div>

            <div class="login-user-info" style="display:flex;align-items:center;gap:10px;padding:4px 6px 4px 10px;">
                <span class="user-name" id="top-bar-username-display" style="cursor:pointer;display:flex;align-items:center;gap:8px;" onclick="openProfileModal()" title="View Profile & Settings">
                    <span class="user-avatar-small" id="user-avatar-topbar">
                        <% if (user.image || user.profilePic) { %>
                            <%- user.image || user.profilePic %>
                        <% } else { %>
                            <%= (user.displayName || user.profileName || user.username).charAt(0).toUpperCase() %>
                        <% } %>
                    </span>
                    Hi, <span id="top-bar-user-name-text"><%= user.displayName || user.profileName || user.username %></span>
                </span>
                <a href="/auth/logout" class="logout-btn">
                  Logout
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M10 12.5a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-9a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v2a.5.5 0 0 0 1 0v-2A1.5 1.5 0 0 0 9.5 2h-8A1.5 1.5 0 0 0 0 3.5v9A1.5 1.5 0 0 0 1.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-2a.5.5 0 0 0-1 0v2z"/>

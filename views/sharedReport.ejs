<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= report ? `Performance Report – ${report.employee?.agentName || 'Team'}` : 'Report Unavailable' %> | PulseTrack</title>
    <meta name="description" content="Secure read-only performance report generated by PulseTrack." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --bg: #0a0c16;
            --surface: #121527;
            --surface2: #1a1e35;
            --surface3: #24294a;
            --border: rgba(255,255,255,0.07);
            --blue: #4f46e5;
            --green: #10b981;
            --green-dim: rgba(16,185,129,0.12);
            --amber: #f59e0b;
            --amber-dim: rgba(245,158,11,0.12);
            --red: #f43f5e;
            --red-dim: rgba(244,63,94,0.12);
            --purple: #8b5cf6;
            --text: #f8fafc;
            --text2: #94a3b8;
            --text-muted: #64748b;
            --radius: 12px;
            --mono: 'JetBrains Mono', monospace;
        }
        html { scroll-behavior: smooth; }
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            font-size: 14px;
            line-height: 1.6;
            min-height: 100vh;
        }

        /* ── Header ─── */
        .report-header {
            background: linear-gradient(135deg, #1a1e35 0%, #24294a 100%);
            border-bottom: 1px solid var(--border);
            padding: 28px 40px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
        }
        .report-brand { display: flex; align-items: center; gap: 14px; }
        .brand-icon {
            width: 44px; height: 44px;
            background: linear-gradient(135deg, var(--blue), #7c3aed);
            border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 22px;
        }
        .brand-name { font-size: 20px; font-weight: 800; }
        .brand-sub  { font-size: 11px; color: var(--text-muted); margin-top: 2px; }

        .report-meta { text-align: right; }
        .meta-label { font-size: 11px; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        .meta-value { font-size: 13px; font-weight: 600; color: var(--text2); font-family: var(--mono); }
        .expiry-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 4px 12px;
            background: var(--amber-dim);
            border: 1px solid rgba(245,158,11,0.2);
            border-radius: 99px;
            font-size: 11px; font-weight: 600; color: var(--amber);
            margin-top: 6px;
        }

        /* ── Main ─── */
        .report-main { max-width: 1100px; margin: 0 auto; padding: 40px 24px 80px; }

        /* ── Employee Card ─── */
        .employee-card {
            background: linear-gradient(135deg, #1a1e35 0%, #24294a 100%);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 28px;
            display: flex;
            align-items: center;
            gap: 24px;
            margin-bottom: 32px;
            position: relative;
            overflow: hidden;
        }
        .employee-card::before {
            content: '';
            position: absolute; top: 0; left: 0; right: 0; height: 3px;
            background: linear-gradient(90deg, var(--blue), #7c3aed, var(--green));
        }
        .emp-avatar {
            width: 72px; height: 72px;
            border-radius: 18px;
            background: linear-gradient(135deg, var(--blue), #7c3aed);
            display: flex; align-items: center; justify-content: center;
            font-size: 28px; font-weight: 800;
            flex-shrink: 0;
            overflow: hidden;
        }
        .emp-avatar img { width: 100%; height: 100%; object-fit: cover; border-radius: 18px; }
        .emp-info { flex: 1; }
        .emp-name  { font-size: 22px; font-weight: 800; margin-bottom: 4px; }
        .emp-meta  { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
        .emp-badge {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px;
            background: rgba(79,70,229,0.12);
            border: 1px solid rgba(79,70,229,0.2);
            border-radius: 6px;
            font-size: 11px; font-weight: 600; color: #a5b4fc;
        }

        /* ── Absent state ─── */
        .error-state {
            max-width: 560px; margin: 80px auto; text-align: center;
            padding: 48px 32px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 24px;
        }
        .error-icon { font-size: 56px; margin-bottom: 20px; }
        .error-title { font-size: 22px; font-weight: 700; margin-bottom: 8px; color: var(--text); }
        .error-msg   { font-size: 14px; color: var(--text-muted); line-height: 1.7; }

        /* ── KPI Grid ─── */
        .section-title {
            font-size: 12px; font-weight: 700; letter-spacing: 0.06em;
            text-transform: uppercase; color: var(--text-muted);
            margin: 0 0 16px;
        }
        .kpi-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
            gap: 14px;
            margin-bottom: 32px;
        }
        .kpi-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 18px 16px;
            position: relative; overflow: hidden;
            transition: border-color 0.2s;
        }
        .kpi-card::before {
            content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
            background: var(--kpi-color, var(--blue));
        }
        .kpi-card:hover { border-color: rgba(255,255,255,0.15); }
        .kpi-icon { font-size: 22px; margin-bottom: 12px; }
        .kpi-value {
            font-family: var(--mono);
            font-size: 26px; font-weight: 700;
            color: var(--text); line-height: 1; margin-bottom: 4px;
        }
        .kpi-label { font-size: 10px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.06em; }
        .kpi-attendance { --kpi-color: var(--green); }
        .kpi-quality    { --kpi-color: var(--blue); }
        .kpi-aht        { --kpi-color: var(--purple); }
        .kpi-tickets    { --kpi-color: var(--amber); }
        .kpi-leaves     { --kpi-color: var(--amber); }
        .kpi-late       { --kpi-color: var(--red); }

        /* ── Table ─── */
        .table-wrap { overflow-x: auto; border-radius: var(--radius); border: 1px solid var(--border); margin-bottom: 32px; }
        table { width: 100%; border-collapse: collapse; font-size: 13px; }
        thead th {
            background: var(--surface2);
            padding: 10px 14px;
            text-align: left;
            font-size: 11px; font-weight: 600;
            color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.04em;
            border-bottom: 1px solid var(--border);
        }
        tbody tr { border-bottom: 1px solid var(--border); transition: background 0.15s; }
        tbody tr:last-child { border-bottom: none; }
        tbody tr:hover { background: var(--surface2); }
        tbody td { padding: 10px 14px; color: var(--text2); font-family: var(--mono); font-size: 12px; }
        tbody td.agent-name { font-family: 'Plus Jakarta Sans', sans-serif; color: var(--text); font-weight: 600; }
        .badge-cell {
            display: inline-flex; align-items: center; gap: 4px;
            padding: 2px 8px; border-radius: 99px;
            font-size: 11px; font-weight: 600; text-transform: capitalize;
        }
        .badge-present  { background: var(--green-dim);  color: var(--green); }
        .badge-absent   { background: var(--red-dim);    color: var(--red); }
        .badge-leave    { background: var(--amber-dim);  color: var(--amber); }
        .badge-wfh, .badge-work_from_home { background: rgba(79,70,229,0.12); color: #a5b4fc; }
        .badge-week_off { background: rgba(139,92,246,0.12); color: var(--purple); }
        .badge-training { background: rgba(45,212,191,0.12); color: #2dd4bf; }
        .badge-half_day { background: var(--amber-dim); color: var(--amber); }

        /* ── Footer ─── */
        .report-footer {
            margin-top: 40px;
            padding-top: 24px;
            border-top: 1px solid var(--border);
            text-align: center;
            color: var(--text-muted);
            font-size: 12px;
        }
        .footer-lock { font-size: 16px; display: block; margin-bottom: 8px; }
        .print-btn {
            position: fixed; bottom: 28px; right: 28px;
            background: linear-gradient(135deg, var(--blue), #7c3aed);
            color: white; border: none; border-radius: 12px;
            padding: 12px 24px; font-size: 14px; font-weight: 700;
            cursor: pointer; box-shadow: 0 8px 32px rgba(79,70,229,0.4);
            display: flex; align-items: center; gap: 8px;
            transition: transform 0.2s, box-shadow 0.2s;
            z-index: 100;
        }
        .print-btn:hover { transform: translateY(-2px); box-shadow: 0 12px 40px rgba(79,70,229,0.5); }

        @media print {
            .print-btn, .report-header .report-meta .expiry-badge { display: none !important; }
            body { background: white; color: #111; }
            .kpi-card, .employee-card, .report-header { background: white; border-color: #ddd; }
            table, thead th, tbody td { color: #111; }
        }
    </style>
</head>
<body>

<% if (error) { %>
<!-- ERROR STATE -->
<div style="min-height:100vh;display:flex;align-items:center;justify-content:center;padding:24px;">
    <div class="error-state">
        <div class="error-icon">🔒</div>
        <div class="error-title">Report Unavailable</div>
        <p class="error-msg"><%= error %></p>
        <p style="margin-top:16px;font-size:12px;color:var(--text-muted);">
            This link may have expired or been revoked. Contact your manager for a new link.
        </p>
    </div>
</div>

<% } else if (report) { %>

<!-- REPORT HEADER -->
<header class="report-header">
    <div class="report-brand">
        <div class="brand-icon">📊</div>
        <div>
            <div class="brand-name">PulseTrack</div>
            <div class="brand-sub">Performance Report — Read Only</div>
        </div>
    </div>
    <div class="report-meta">
        <div class="meta-label">Expires</div>
        <div class="meta-value"><%= new Date(report.metadata.expiresAt).toLocaleString() %></div>
        <% if (report.metadata.oneTimeView) { %>
        <div class="expiry-badge">⚡ One-time view — link now expired</div>
        <% } else { %>
        <div class="expiry-badge">🔒 Secure read-only link</div>
        <% } %>
    </div>
</header>

<!-- MAIN CONTENT -->
<main class="report-main">

    <!-- Employee Card -->
    <% if (report.employee) { %>
    <div class="employee-card">
        <div class="emp-avatar">
            <% if (report.employee.image) { %>
                <img src="<%= report.employee.image %>" alt="<%= report.employee.agentName %>" />
            <% } else { %>
                <%= (report.employee.agentName || 'A').charAt(0).toUpperCase() %>
            <% } %>
        </div>
        <div class="emp-info">
            <div class="emp-name"><%= report.employee.agentName || 'Unknown Agent' %></div>
            <div style="color:var(--text-muted);font-size:13px;margin-top:2px;">
                Employee #<span style="font-family:var(--mono);color:var(--text2)"><%= report.employee.employeeId || 'N/A' %></span>
            </div>
            <div class="emp-meta">
                <% if (report.employee.department) { %>
                <span class="emp-badge">🏢 <%= report.employee.department %></span>
                <% } %>
                <% if (report.employee.teamName) { %>
                <span class="emp-badge">👥 <%= report.employee.teamName %></span>
                <% } %>
                <% if (report.employee.shiftType) { %>
                <span class="emp-badge">🕐 <%= report.employee.shiftType %> shift</span>
                <% } %>
            </div>
        </div>
    </div>
    <% } else { %>
    <div style="margin-bottom:24px;padding:16px 20px;background:var(--surface);border:1px solid var(--border);border-radius:12px;color:var(--text-muted);font-size:13px;">
        📊 Team / Department Level Report
        <% if (report.filters.dept) { %> · Department: <strong><%= report.filters.dept %></strong><% } %>
        <% if (report.filters.from) { %> · From: <strong><%= report.filters.from %></strong><% } %>
        <% if (report.filters.to) { %> · To: <strong><%= report.filters.to %></strong><% } %>
    </div>
    <% } %>

    <!-- KPI Summary -->
    <div class="section-title">Performance Summary</div>
    <div class="kpi-grid">
        <div class="kpi-card kpi-attendance">
            <div class="kpi-icon">✅</div>
            <div class="kpi-value"><%= report.summary.attendancePct %>%</div>
            <div class="kpi-label">Attendance</div>
        </div>
        <div class="kpi-card kpi-quality">
            <div class="kpi-icon">⭐</div>
            <div class="kpi-value"><%= report.summary.avgQuality %><span style="font-size:14px;color:var(--text-muted)">%</span></div>
            <div class="kpi-label">Quality Score</div>
        </div>
        <div class="kpi-card kpi-aht">
            <div class="kpi-icon">⏱️</div>
            <div class="kpi-value"><%= report.summary.avgAHT %><span style="font-size:14px;color:var(--text-muted)">m</span></div>
            <div class="kpi-label">Avg AHT</div>
        </div>
        <div class="kpi-card kpi-tickets">
            <div class="kpi-icon">🎟️</div>
            <div class="kpi-value"><%= report.summary.totalTickets %></div>
            <div class="kpi-label">Tickets</div>
        </div>
        <div class="kpi-card kpi-leaves">
            <div class="kpi-icon">🌿</div>
            <div class="kpi-value"><%= report.summary.leavesUsed %></div>
            <div class="kpi-label">Leaves Used</div>
        </div>
        <div class="kpi-card kpi-late">
            <div class="kpi-icon">🕐</div>
            <div class="kpi-value"><%= report.summary.lateDays %></div>
            <div class="kpi-label">Late Days</div>
        </div>
    </div>

    <!-- Recent Records Table -->
    <% if (report.records && report.records.length > 0) { %>
    <div class="section-title" style="margin-top:0;">Recent Attendance & Performance Records</div>
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Status</th>
                    <th>Shift</th>
                    <th>Login</th>
                    <th>Logout</th>
                    <th>Login Hrs</th>
                    <th>Late (min)</th>
                    <th>AHT</th>
                    <th>Quality</th>
                    <th>Tickets</th>
                </tr>
            </thead>
            <tbody>
                <% report.records.forEach(r => { %>
                <tr>
                    <td><%= r.date ? new Date(r.date).toLocaleDateString('en-IN', { day:'2-digit', month:'short', year:'numeric' }) : '—' %></td>
                    <td><span class="badge-cell badge-<%= (r.status||'').replace(' ','_') %>"><%= r.status || '—' %></span></td>
                    <td><%= r.shiftType || '—' %></td>
                    <td><%= r.loginTime || '—' %></td>
                    <td><%= r.logoutTime || '—' %></td>
                    <td><%= r.loginHrs ? Number(r.loginHrs).toFixed(1) : '—' %></td>
                    <td style="color:<%= r.lateLoginMins > 0 ? 'var(--red)' : 'var(--text-muted)' %>"><%= r.lateLoginMins || 0 %></td>
                    <td><%= r.aht ? Number(r.aht).toFixed(1) : '—' %></td>
                    <td><%= r.qualityScore ? Number(r.qualityScore).toFixed(1) + '%' : '—' %></td>
                    <td><%= r.ticketsProcessed || 0 %></td>
                </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
    <% } else { %>
    <div style="padding:32px;text-align:center;color:var(--text-muted);background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);">
        No records found for the selected period.
    </div>
    <% } %>

    <!-- Footer -->
    <div class="report-footer">
        <span class="footer-lock">🔒</span>
        This is a secure, read-only report generated by <strong>PulseTrack</strong>.
        It was created on <%= new Date(report.metadata.sharedAt).toLocaleDateString() %>
        and expires on <%= new Date(report.metadata.expiresAt).toLocaleString() %>.
        <br />No modifications can be made via this link.
    </div>

</main>

<button class="print-btn" onclick="window.print()">🖨️ Print / Save as PDF</button>

<% if (report.metadata.printMode) { %>
<script>
    // Auto-trigger print dialog when opened with ?print=1
    window.addEventListener('load', () => setTimeout(() => window.print(), 800));
</script>
<% } %>

<% } %>
</body>
</html>
